// Analyzer-path tables (phase 2, step 1). The full model is drafted in
// docs/design/06-database-and-state-machines.md; tables are added here as
// each part is built. Constraints Prisma cannot express (fencing triggers)
// are in the hand-reviewed migration SQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VerificationStatus {
  UNVERIFIED
  VENDOR_TESTED
  LAB_ACCEPTED
  SUSPENDED
}

enum MappingStatus {
  DRAFT
  APPROVED
  ACTIVE
  RETIRED
}

enum Direction {
  IN
  OUT
}

enum TransportAck {
  PENDING
  ACKED
  NAKED
  NOT_APPLICABLE
}

enum QueueStatus {
  PENDING
  IN_PROGRESS
  DONE
  FAILED
  DEAD
}

model Instrument {
  id                      String             @id
  displayName             String             @map("display_name")
  manufacturer            String
  model                   String
  serialNo                String?            @map("serial_no")
  softwareVersion         String?            @map("software_version")
  verifiedSoftwareVersion String?            @map("verified_software_version")
  discipline              String
  location                String?
  interfaceManualRef      String?            @map("interface_manual_ref")
  verificationStatus      VerificationStatus @default(UNVERIFIED) @map("verification_status")
  enabled                 Boolean            @default(false)
  createdAt               DateTime           @default(now()) @map("created_at") @db.Timestamptz
  createdBy               String             @map("created_by")
  version                 Int                @default(1)

  connections InstrumentConnection[]
  mappingSets TestMappingSet[]
  evidence    InstrumentVerificationEvidence[]
  lease       InstrumentConnectionLease?

  @@map("instrument")
  qcRanges QcRange[]
}

model InstrumentVerificationEvidence {
  id           String             @id @db.Uuid
  instrumentId String             @map("instrument_id")
  kind         String
  evidenceJson Json               @map("evidence_json")
  fromStatus   VerificationStatus @map("from_status")
  toStatus     VerificationStatus @map("to_status")
  recordedBy   String             @map("recorded_by")
  recordedAt   DateTime           @default(now()) @map("recorded_at") @db.Timestamptz
  instrument   Instrument         @relation(fields: [instrumentId], references: [id])

  @@index([instrumentId, recordedAt])
  @@map("instrument_verification_evidence")
}

model InstrumentConnection {
  id           String     @id @db.Uuid
  instrumentId String     @map("instrument_id")
  /// Validated by InstrumentConnectionConfig on write and on read.
  configJson   Json       @map("config_json")
  activeFrom   DateTime   @map("active_from") @db.Timestamptz
  activeTo     DateTime?  @map("active_to") @db.Timestamptz
  createdBy    String     @map("created_by")
  instrument   Instrument @relation(fields: [instrumentId], references: [id])

  @@index([instrumentId, activeFrom])
  @@map("instrument_connection")
}

model InstrumentConnectionLease {
  instrumentId String     @id @map("instrument_id")
  /// host:pid:bootId of the worker holding the link.
  owner        String
  /// Fencing token, incremented on every acquisition.
  epoch        BigInt     @default(0)
  leaseUntil   DateTime   @map("lease_until") @db.Timestamptz
  instrument   Instrument @relation(fields: [instrumentId], references: [id])

  @@map("instrument_connection_lease")
}

model TestMappingSet {
  id           String        @id @db.Uuid
  instrumentId String        @map("instrument_id")
  versionNo    Int           @map("version_no")
  status       MappingStatus
  createdBy    String        @map("created_by")
  approvedBy   String?       @map("approved_by")
  approvedAt   DateTime?     @map("approved_at") @db.Timestamptz
  activeFrom   DateTime?     @map("active_from") @db.Timestamptz
  /// TestMapping[] validated by the TestMappingSet contract.
  mappingsJson Json          @map("mappings_json")
  instrument   Instrument    @relation(fields: [instrumentId], references: [id])

  @@unique([instrumentId, versionNo])
  @@map("test_mapping_set")
}

model LinkSession {
  id           String    @id @db.Uuid
  instrumentId String    @map("instrument_id")
  leaseEpoch   BigInt    @map("lease_epoch")
  owner        String
  startedAt    DateTime  @default(now()) @map("started_at") @db.Timestamptz
  endedAt      DateTime? @map("ended_at") @db.Timestamptz
  endReason    String?   @map("end_reason")

  frames   RawFrame[]
  messages RawMessage[]

  @@index([instrumentId, startedAt])
  @@map("link_session")
}

model RawMessage {
  id            String       @id @db.Uuid
  instrumentId  String       @map("instrument_id")
  leaseEpoch    BigInt       @map("lease_epoch")
  linkSessionId String?      @map("link_session_id") @db.Uuid
  direction     Direction
  /// "astm-e1381" or "hl7-mllp".
  protocol      String
  /// Exact bytes. Access is restricted and audited.
  bytes         Bytes
  sha256        String
  complete      Boolean
  abortedReason String?      @map("aborted_reason")
  receivedAt    DateTime     @map("received_at") @db.Timestamptz
  transportAck  TransportAck @map("transport_ack")
  dedupeKey     String?      @map("dedupe_key")
  frames        RawFrame[]
  linkSession   LinkSession? @relation(fields: [linkSessionId], references: [id])

  @@index([instrumentId, receivedAt])
  @@index([sha256])
  @@map("raw_message")
}

model RawFrame {
  id            String      @id @db.Uuid
  instrumentId  String      @map("instrument_id")
  leaseEpoch    BigInt      @map("lease_epoch")
  linkSessionId String      @map("link_session_id") @db.Uuid
  rawMessageId  String?     @map("raw_message_id") @db.Uuid
  seq           Int
  fn            Int
  bytes         Bytes
  final         Boolean
  receivedAt    DateTime    @map("received_at") @db.Timestamptz
  linkSession   LinkSession @relation(fields: [linkSessionId], references: [id])
  rawMessage    RawMessage? @relation(fields: [rawMessageId], references: [id])

  @@unique([linkSessionId, seq])
  @@map("raw_frame")
}

model InboxMessage {
  id           String      @id @db.Uuid
  /// "hmis-webhook", "hmis-poll", "analyzer:e411-01"
  source       String
  /// Provider message id, or raw message id.
  externalId   String      @map("external_id")
  payload      Json?
  rawMessageId String?     @map("raw_message_id") @db.Uuid
  status       QueueStatus @default(PENDING)
  attempts     Int         @default(0)
  availableAt  DateTime    @default(now()) @map("available_at") @db.Timestamptz
  leasedBy     String?     @map("leased_by")
  leaseUntil   DateTime?   @map("lease_until") @db.Timestamptz
  lastError    String?     @map("last_error")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz

  @@unique([source, externalId])
  @@index([status, availableAt])
  @@map("inbox_message")
}

enum ObservationMapping {
  MAPPED
  UNMAPPED
  NOT_REPORTABLE
  QC
}

/// One sample's worth of results decoded from a raw message by an adapter.
/// A raw message can yield several (one per order record / OBR group).
model NormalizedMessage {
  id               String        @id @db.Uuid
  rawMessageId     String        @map("raw_message_id") @db.Uuid
  seq              Int
  instrumentId     String        @map("instrument_id")
  adapterName      String        @map("adapter_name")
  adapterVersion   String        @map("adapter_version")
  kind             String
  sampleClass      String        @map("sample_class")
  sampleId         String?       @map("sample_id")
  sampleIdReadError Boolean      @map("sample_id_read_error")
  /// Version of the ACTIVE mapping set used; null when none was active.
  mappingVersionNo Int?          @map("mapping_version_no")
  /// Full NormalizedAnalyzerMessage as produced by the adapter.
  payload          Json
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz
  observations     Observation[]

  @@unique([rawMessageId, seq])
  @@index([instrumentId, sampleId])
  @@map("normalized_message")
}

model Observation {
  id                  String             @id @db.Uuid
  normalizedMessageId String             @map("normalized_message_id") @db.Uuid
  seq                 Int
  instrumentTestCode  String             @map("instrument_test_code")
  instrumentCodeSystem String?           @map("instrument_code_system")
  /// Exactly as received.
  originalValueText   String             @map("original_value_text")
  /// ResultValue (decimal strings, never floats).
  value               Json
  /// Set only for plain numeric values, for range queries. Clinical logic uses `value`.
  numericValue        Decimal?           @map("numeric_value") @db.Decimal(30, 10)
  units               String?
  abnormalFlags       String[]           @map("abnormal_flags")
  mapping             ObservationMapping
  localTestCode       String?            @map("local_test_code")
  normalizedMessage   NormalizedMessage  @relation(fields: [normalizedMessageId], references: [id])
  qcEvaluation        QcEvaluation?

  @@unique([normalizedMessageId, seq])
  @@index([mapping])
  @@map("observation")
}

// ---------- Patients, orders, specimens (from the HMIS) ----------

model Patient {
  id         String     @id @db.Uuid
  mrn        String     @unique
  familyName String?    @map("family_name")
  givenName  String?    @map("given_name")
  birthDate  DateTime?  @map("birth_date") @db.Date
  sex        String?
  updatedAt  DateTime   @default(now()) @map("updated_at") @db.Timestamptz
  /// Registered by hand during HMIS downtime (06 §5.2); never the HMIS's record.
  provisional Boolean   @default(false)
  /// The HMIS patient this provisional record was reconciled to. Never deleted.
  mergedIntoId String?  @map("merged_into_id") @db.Uuid
  orders     LabOrder[]
  mergesFrom PatientMerge[] @relation("MergeFrom")
  mergesInto PatientMerge[] @relation("MergeInto")

  @@map("patient")
}

/// A merge of two MRNs recorded by the lab, after medical records merged them in the HMIS (A-35).
model PatientMerge {
  id            String    @id @db.Uuid
  fromPatientId String    @map("from_patient_id") @db.Uuid
  intoPatientId String    @map("into_patient_id") @db.Uuid
  /// PROPOSED, CONFIRMED, WITHDRAWN or UNDONE.
  status        String    @default("PROPOSED")
  /// The HMIS or medical records reference for the merge.
  reference     String
  reason        String
  proposedBy    String    @map("proposed_by")
  proposedAt    DateTime  @default(now()) @map("proposed_at") @db.Timestamptz
  decidedBy     String?   @map("decided_by")
  decidedAt     DateTime? @map("decided_at") @db.Timestamptz
  /// Undoing a confirmed merge (A-39): proposed by one person, done by another.
  undoReference String?   @map("undo_reference")
  undoReason    String?   @map("undo_reason")
  undoProposedBy String?  @map("undo_proposed_by")
  undoProposedAt DateTime? @map("undo_proposed_at") @db.Timestamptz
  undoneBy      String?   @map("undone_by")
  undoneAt      DateTime? @map("undone_at") @db.Timestamptz
  from          Patient   @relation("MergeFrom", fields: [fromPatientId], references: [id], onDelete: Restrict, map: "patient_merge_from_fkey")
  into          Patient   @relation("MergeInto", fields: [intoPatientId], references: [id], onDelete: Restrict, map: "patient_merge_into_fkey")

  @@index([intoPatientId], map: "patient_merge_into")
  @@map("patient_merge")
}

model LabOrder {
  id                String        @id @db.Uuid
  hmisOrderId       String        @unique @map("hmis_order_id")
  patientId         String        @map("patient_id") @db.Uuid
  hmisEncounterId   String?       @map("hmis_encounter_id")
  location          String?
  priority          String
  orderedAt         DateTime      @map("ordered_at") @db.Timestamptz
  orderingClinician String?       @map("ordering_clinician")
  status            String
  /// The canonical order as received, for traceability.
  sourceJson        Json          @map("source_json")
  /// "HMIS", or "MANUAL_DOWNTIME" for an order registered by hand (06 §5.2).
  source            String        @default("HMIS")
  /// For a downtime order: the HMIS order its specimens and results were moved to.
  reconciledToId    String?       @map("reconciled_to_id") @db.Uuid
  reconciledAt      DateTime?     @map("reconciled_at") @db.Timestamptz
  reconciledBy      String?       @map("reconciled_by")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz
  patient           Patient       @relation(fields: [patientId], references: [id])
  tests             OrderedTest[]
  specimens         Specimen[]

  @@map("lab_order")
}

model OrderedTest {
  id            String   @id @db.Uuid
  orderId       String   @map("order_id") @db.Uuid
  hmisLineId    String   @map("hmis_line_id")
  hmisTestCode  String   @map("hmis_test_code")
  /// Null when the HMIS code has no mapping: the order needs attention (07 §6.4).
  localTestCode String?  @map("local_test_code")
  specimenType  String?  @map("specimen_type")
  status        String
  specimenId    String?  @map("specimen_id") @db.Uuid
  /// For one component of a panel order line: the component's local code; '' for an ordinary line (A-32).
  componentCode String   @default("") @map("component_code")
  /// The panel's local code when this row is one of its components.
  panelCode     String?  @map("panel_code")
  /// HMIS, or LAB_ADDED for a test added by the lab from an unmatched result (A-34).
  source        String   @default("HMIS")
  /// For a LAB_ADDED test: the clinician who asked for it, who proposed and confirmed it, and why.
  requestedBy   String?  @map("requested_by")
  addedBy       String?  @map("added_by")
  addedConfirmedBy String? @map("added_confirmed_by")
  addedReason   String?  @map("added_reason")
  addedAt       DateTime? @map("added_at") @db.Timestamptz
  /// The HMIS line's test this added test's specimen and result moved to.
  matchedToId   String?  @map("matched_to_id") @db.Uuid
  matchedBy     String?  @map("matched_by")
  matchedAt     DateTime? @map("matched_at") @db.Timestamptz
  matchedTo     OrderedTest? @relation("AddedTestMatch", fields: [matchedToId], references: [id], onDelete: Restrict)
  matchedFrom   OrderedTest[] @relation("AddedTestMatch")
  order         LabOrder @relation(fields: [orderId], references: [id])
  specimen      Specimen? @relation(fields: [specimenId], references: [id])
  result        Result?
  sendOuts      SendOutTest[]

  @@unique([orderId, hmisLineId, componentCode])
  @@map("ordered_test")
}

model HmisCodeMap {
  hmisTestCode  String @id @map("hmis_test_code")
  localTestCode String @map("local_test_code")

  @@map("hmis_code_map")
}

model HmisCursor {
  name      String   @id
  cursor    String?
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@map("hmis_cursor")
}

/// How the jobs worker's last HMIS polls went (07 §6.6).
model HmisPollStatus {
  name            String    @id
  profile         String
  lastAttemptAt   DateTime  @map("last_attempt_at") @db.Timestamptz
  lastSuccessAt   DateTime? @map("last_success_at") @db.Timestamptz
  lastReceived    Int       @default(0) @map("last_received")
  failuresInARow  Int       @default(0) @map("failures_in_a_row")
  lastError       String?   @map("last_error")
  lastErrorAt     DateTime? @map("last_error_at") @db.Timestamptz

  @@map("hmis_poll_status")
}

model Specimen {
  id          String        @id @db.Uuid
  orderId     String        @map("order_id") @db.Uuid
  accessionNo String        @unique @map("accession_no")
  /// Printed on the label; the only key instruments see.
  barcode     String
  barcodeActive Boolean     @default(true) @map("barcode_active")
  status      String
  collectedAt DateTime?     @map("collected_at") @db.Timestamptz
  receivedAt  DateTime?     @map("received_at") @db.Timestamptz
  receivedBy  String?       @map("received_by")
  /// Times a label was printed for this specimen (W-2 shows the reprint count).
  labelPrints Int           @default(0) @map("label_prints")
  /// Coded reason, then free text (W-2).
  rejectionReason String?   @map("rejection_reason")
  createdBy   String        @map("created_by")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  order       LabOrder      @relation(fields: [orderId], references: [id])
  tests       OrderedTest[]
  sendOuts    SendOut[]

  @@index([barcode])
  @@map("specimen")
}

// ---------- Results ----------

model Result {
  id                   String          @id @db.Uuid
  orderedTestId        String          @unique @map("ordered_test_id") @db.Uuid
  status               String
  selectedVersionNo    Int?            @map("selected_version_no")
  reviewedBy           String?         @map("reviewed_by")
  approvedBy           String?         @map("approved_by")
  releaseCount         Int             @default(0) @map("release_count")
  deliveryKey          String?         @map("delivery_key")
  deliveredKey         String?         @map("delivered_key")
  newDataAfterApproval Boolean         @default(false) @map("new_data_after_approval")
  needsConfirmation    Boolean         @default(false) @map("needs_confirmation")
  instrumentId         String?         @map("instrument_id")
  /// Optimistic concurrency.
  version              Int             @default(1)
  updatedAt            DateTime        @default(now()) @map("updated_at") @db.Timestamptz
  orderedTest          OrderedTest     @relation(fields: [orderedTestId], references: [id])
  versions             ResultVersion[]
  events               ResultEvent[]
  criticalCalls        CriticalCall[]
  autoverifications    AutoverificationDecision[]
  comments             ResultComment[]

  @@index([status])
  @@map("result")
}

model ResultVersion {
  id            String   @id @db.Uuid
  resultId      String   @map("result_id") @db.Uuid
  versionNo     Int      @map("version_no")
  kind          String
  value         Json
  units         String?
  abnormalFlags String[] @map("abnormal_flags")
  observationId String?  @map("observation_id") @db.Uuid
  reason        String?
  createdBy     String   @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  /// LOW, HIGH or UNITS_DIFFER, set once when the version is written (08 §12).
  criticalFlag    String? @map("critical_flag")
  criticalLimitId String? @map("critical_limit_id") @db.Uuid
  criticalDetail  String? @map("critical_detail")
  /// EXCEEDED or UNITS_DIFFER from the delta check, set once when the version is written (08 §12, A-20).
  deltaFlag             String? @map("delta_flag")
  deltaRuleId           String? @map("delta_rule_id") @db.Uuid
  deltaPreviousResultId String? @map("delta_previous_result_id") @db.Uuid
  deltaDetail           String? @map("delta_detail")
  result        Result   @relation(fields: [resultId], references: [id])

  @@unique([resultId, versionNo])
  @@map("result_version")
}

/// Append-only record of every human decision on a result.
model ResultEvent {
  id        String   @id @db.Uuid
  resultId  String   @map("result_id") @db.Uuid
  /// review, approve, release, replay, correct, delivery
  kind      String
  versionNo Int?     @map("version_no")
  actor     String
  reason    String?
  detail    Json?
  at        DateTime @default(now()) @db.Timestamptz
  result    Result   @relation(fields: [resultId], references: [id])

  @@index([resultId, at])
  @@map("result_event")
}

/// Observations that could not be matched (06 §5). Resolved by a person.
model UnmatchedResult {
  id            String    @id @db.Uuid
  observationId String    @unique @map("observation_id") @db.Uuid
  reason        String
  sampleId      String?   @map("sample_id")
  instrumentId  String    @map("instrument_id")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  resolvedAt    DateTime? @map("resolved_at") @db.Timestamptz
  resolvedBy    String?   @map("resolved_by")
  resolution    String?
  /// A proposed link to a specimen's ordered test, waiting for a second person (10 §2).
  proposedTestId String?  @map("proposed_test_id") @db.Uuid
  proposedBy    String?   @map("proposed_by")
  proposedAt    DateTime? @map("proposed_at") @db.Timestamptz
  proposalReason String?  @map("proposal_reason")
  /// LINK (to proposedTestId) or ADD_TEST (a new test on proposedSpecimenId, A-34).
  proposedAction String?  @map("proposed_action")
  proposedSpecimenId String? @map("proposed_specimen_id") @db.Uuid
  /// For ADD_TEST: the clinician who asked for the test.
  proposedRequestedBy String? @map("proposed_requested_by")
  /// The result the observation became once the link was confirmed.
  linkedResultId String?  @map("linked_result_id") @db.Uuid

  @@index([resolvedAt])
  @@map("unmatched_result")
}

// ---------- Outbox ----------

model OutboxMessage {
  id             String            @id @db.Uuid
  topic          String
  /// For result topics: the result and version being released (checked by trigger).
  resultId       String?           @map("result_id") @db.Uuid
  versionNo      Int?              @map("version_no")
  idempotencyKey String            @unique @map("idempotency_key")
  payload        Json
  status         QueueStatus       @default(PENDING)
  attempts       Int               @default(0)
  availableAt    DateTime          @default(now()) @map("available_at") @db.Timestamptz
  leasedBy       String?           @map("leased_by")
  leaseUntil     DateTime?         @map("lease_until") @db.Timestamptz
  lastError      String?           @map("last_error")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz
  attemptsLog    DeliveryAttempt[]

  @@index([status, availableAt])
  @@map("outbox_message")
}

model DeliveryAttempt {
  id         String        @id @db.Uuid
  outboxId   String        @map("outbox_id") @db.Uuid
  startedAt  DateTime      @map("started_at") @db.Timestamptz
  finishedAt DateTime      @map("finished_at") @db.Timestamptz
  outcome    String
  detail     String?
  outbox     OutboxMessage @relation(fields: [outboxId], references: [id])

  @@map("delivery_attempt")
}

// ---------- Clinical audit trail (10 §8) ----------

model AuditEvent {
  seq           BigInt   @id @default(autoincrement())
  id            String   @unique @db.Uuid
  at            DateTime @default(now()) @db.Timestamptz
  actor         String
  action        String
  entityType    String   @map("entity_type")
  entityId      String   @map("entity_id")
  reason        String?
  correlationId String?  @map("correlation_id")
  before        Json?
  after         Json?
  prevHash      String   @map("prev_hash")
  hash          String

  @@index([entityType, entityId])
  @@map("audit_event")
}

// ---------- Users and sessions (local accounts; LDAPS/OIDC later, 10 §3) ----------

model AppUser {
  id           String        @id @db.Uuid
  username     String        @unique
  displayName  String        @map("display_name")
  /// scrypt$N$r$p$salt$hash
  passwordHash String        @map("password_hash")
  /// admin, technologist, approver, operator, auditor
  roles        String[]
  active       Boolean       @default(true)
  /// Consecutive failed sign-ins; 5 locks the account for 15 minutes (10 §3).
  failedLogins Int           @default(0) @map("failed_logins")
  lockedUntil  DateTime?     @map("locked_until") @db.Timestamptz
  /// Set when an administrator sets a temporary password; cleared when the person chooses their own.
  mustChangePassword Boolean @default(false) @map("must_change_password")
  passwordChangedAt DateTime? @map("password_changed_at") @db.Timestamptz
  /// "local" (password here) or "oidc" (hospital sign-in; roles come from directory groups).
  authSource   String        @default("local") @map("auth_source")
  oidcIssuer   String?       @map("oidc_issuer")
  oidcSubject  String?       @map("oidc_subject")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  sessions     UserSession[]

  @@unique([oidcIssuer, oidcSubject])
  @@map("app_user")
}

model UserSession {
  /// Random 256-bit token (hex) kept in an HttpOnly cookie; stored hashed.
  tokenHash  String   @id @map("token_hash")
  userId     String   @map("user_id") @db.Uuid
  csrfToken  String   @map("csrf_token")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  /// Idle expiry; slides forward on use but never past createdAt + absolute limit.
  expiresAt  DateTime @map("expires_at") @db.Timestamptz
  /// Hospital sign-in re-confirmed for one approval-type action (10 §3 step-up); used once.
  stepUpAt   DateTime? @map("step_up_at") @db.Timestamptz
  user       AppUser  @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("user_session")
}

// ---------- Critical results (08 §12) ----------

/// A critical (panic) limit set by the lab director. Never edited: a change retires it and adds a new one.
model CriticalLimit {
  id            String    @id @db.Uuid
  localTestCode String    @map("local_test_code")
  /// F or M; null applies to everyone.
  sex           String?
  ageMinDays    Int?      @map("age_min_days")
  ageMaxDays    Int?      @map("age_max_days")
  /// Decimal text, compared exactly. Critical when strictly below low or strictly above high.
  low           String?
  high          String?
  units         String
  /// The lab policy or document the values come from.
  reference     String
  active        Boolean   @default(true)
  createdBy     String    @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  retiredBy     String?   @map("retired_by")
  retiredAt     DateTime? @map("retired_at") @db.Timestamptz
  retireReason  String?   @map("retire_reason")

  @@index([localTestCode, active])
  @@map("critical_limit")
}

/// How soon a critical result must be phoned, in minutes from its arrival (A-37).
/// At most one active target per test and one lab-wide (partial unique index in SQL).
model CriticalCallTarget {
  id            String    @id @db.Uuid
  /// Null is the lab-wide target.
  localTestCode String?   @map("local_test_code")
  minutes       Int
  reference     String
  active        Boolean   @default(true)
  createdBy     String    @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  retiredBy     String?   @map("retired_by")
  retiredAt     DateTime? @map("retired_at") @db.Timestamptz
  retireReason  String?   @map("retire_reason")

  @@index([active])
  @@map("critical_call_target")
}

/// Reference range entered by the lab (01 A-25); none shipped. Inclusive. Shown to people only.
model ReferenceRange {
  id            String    @id @db.Uuid
  localTestCode String    @map("local_test_code")
  /// F or M; null applies to everyone.
  sex           String?
  ageMinDays    Int?      @map("age_min_days")
  ageMaxDays    Int?      @map("age_max_days")
  /// Decimal text, compared exactly.
  low           String?
  high          String?
  units         String
  reference     String
  active        Boolean   @default(true)
  createdBy     String    @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  retiredBy     String?   @map("retired_by")
  retiredAt     DateTime? @map("retired_at") @db.Timestamptz
  retireReason  String?   @map("retire_reason")

  @@index([localTestCode, active])
  @@map("reference_range")
}

/// A note on a result (01 A-26). Never edited or deleted, only withdrawn (enforced by a trigger).
model ResultComment {
  id             String    @id @db.Uuid
  resultId       String    @map("result_id") @db.Uuid
  text           String
  /// Printed on the result report under the value; otherwise for lab staff only.
  onReport       Boolean   @map("on_report")
  createdBy      String    @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  withdrawnBy    String?   @map("withdrawn_by")
  withdrawnAt    DateTime? @map("withdrawn_at") @db.Timestamptz
  withdrawReason String?   @map("withdraw_reason")
  result         Result    @relation(fields: [resultId], references: [id])

  @@index([resultId, createdAt])
  @@map("result_comment")
}

/// A comment the lab keeps ready to pick on a result (01 A-27); none shipped. Copied into the result comment when used.
model StandardComment {
  id            String    @id @db.Uuid
  /// Short code staff know it by, such as HAEM.
  code          String
  text          String
  /// Offered only on this test's results; null offers it on every test.
  localTestCode String?   @map("local_test_code")
  active        Boolean   @default(true)
  createdBy     String    @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  retiredBy     String?   @map("retired_by")
  retiredAt     DateTime? @map("retired_at") @db.Timestamptz
  retireReason  String?   @map("retire_reason")

  @@map("standard_comment")
}

/// One version of a test in the lab's own catalogue (design: "Test catalogue and LOINC"). None shipped.
/// A change is a new DRAFT version that a second person makes ACTIVE; the old one is then RETIRED.
model TestCatalogueEntry {
  id           String    @id @db.Uuid
  localCode    String    @map("local_code")
  versionNo    Int       @map("version_no")
  /// DRAFT, ACTIVE, RETIRED or DISCARDED (a draft not taken up).
  status       String    @default("DRAFT")
  name         String
  /// The bench: chemistry, haematology, parasitology, urinalysis, ...
  section      String
  /// The LOINC term for this method and specimen, chosen and approved by the lab.
  loincCode    String?   @map("loinc_code")
  loincDisplay String?   @map("loinc_display")
  /// Optional SHA code, filled only from the official SHA and DHA publications.
  shaCode      String?   @map("sha_code")
  specimenType String?   @map("specimen_type")
  /// INSTRUMENT or MANUAL (entered on the worksheet).
  performedBy  String    @map("performed_by")
  /// NUMERIC, ORDINAL, NOMINAL, TEXT or PANEL.
  resultType   String    @map("result_type")
  /// For ORDINAL and NOMINAL: [{ code, display, abnormal?, loinc? }], in rank order for ORDINAL.
  answers      Json      @default("[]")
  /// For PANEL: the component tests' local codes, in report order (A-32).
  components   Json      @default("[]")
  /// UCUM unit for NUMERIC.
  unit         String?
  decimals     Int?
  /// For a manual test or panel: NONE, WARN or BLOCK without a passing control for the lot (A-33).
  qcRule       String    @default("NONE") @map("qc_rule")
  /// How long a passing control counts, in hours; null for the whole lot.
  qcValidHours Int?      @map("qc_valid_hours")
  changeReason String    @map("change_reason")
  createdBy    String    @map("created_by")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  approvedBy   String?   @map("approved_by")
  approvedAt   DateTime? @map("approved_at") @db.Timestamptz
  retiredBy    String?   @map("retired_by")
  retiredAt    DateTime? @map("retired_at") @db.Timestamptz
  retireReason String?   @map("retire_reason")

  @@unique([localCode, versionNo], map: "test_catalogue_code_version")
  @@map("test_catalogue")
}

/// A control run on a manual test's kit, strip or stain lot (A-33). Append-only.
model ManualQc {
  id               String    @id @db.Uuid
  localCode        String    @map("local_code")
  catalogueVersion Int       @map("catalogue_version")
  lot              String
  lotExpiry        DateTime? @map("lot_expiry") @db.Date
  /// Which control: positive control, negative control, known positive slide, ...
  control          String
  /// The answer code expected (choice tests) or the expected reading as words.
  expected         String
  observed         String
  /// PASS or FAIL.
  outcome          String
  comment          String?
  performedBy      String    @map("performed_by")
  enteredBy        String    @map("entered_by")
  at               DateTime  @default(now()) @db.Timestamptz

  @@index([localCode, lot, at], map: "manual_qc_code_lot_at")
  @@index([at], map: "manual_qc_at")
  @@map("manual_qc")
}

/// Who was told about a critical result, and that they read it back. Append-only.
model CriticalCall {
  id         String   @id @db.Uuid
  resultId   String   @map("result_id") @db.Uuid
  versionNo  Int      @map("version_no")
  /// Name of the person told.
  notified   String
  /// Their role and place, for example "ward nurse, Ward 3".
  notifiedRole String @map("notified_role")
  calledAt   DateTime @map("called_at") @db.Timestamptz
  readBack   Boolean  @map("read_back")
  note       String?
  recordedBy String   @map("recorded_by")
  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz
  result     Result   @relation(fields: [resultId], references: [id])

  @@index([resultId, versionNo])
  @@map("critical_call")
}

/// Autoverification rule for one test (08 §12, A-19). Set by the lab director after the lab's own validation; no rule, no autoverification.
model AutoverifyRule {
  id             String    @id @db.Uuid
  localTestCode  String    @map("local_test_code")
  /// Decimal text, inclusive. Both required.
  low            String
  high           String
  units          String
  /// The lab's validation report and its version.
  reference      String
  /// The director confirmed how QC is covered; the middleware does not check QC.
  qcAcknowledged Boolean   @map("qc_acknowledged")
  /// Optional: autoverify only when QC for the test on that instrument was in range within this many hours.
  qcWithinHours  Int?      @map("qc_within_hours")
  active         Boolean   @default(true)
  createdBy      String    @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  retiredBy      String?   @map("retired_by")
  retiredAt      DateTime? @map("retired_at") @db.Timestamptz
  retireReason   String?   @map("retire_reason")
  decisions      AutoverificationDecision[]

  @@index([localTestCode, active])
  @@map("autoverify_rule")
}

/// One autoverification decision with every check, append-only.
model AutoverificationDecision {
  id        String         @id @db.Uuid
  resultId  String         @map("result_id") @db.Uuid
  versionNo Int            @map("version_no")
  ruleId    String         @map("rule_id") @db.Uuid
  passed    Boolean
  checks    Json
  at        DateTime       @default(now()) @db.Timestamptz
  result    Result         @relation(fields: [resultId], references: [id])
  rule      AutoverifyRule @relation(fields: [ruleId], references: [id])

  @@index([resultId])
  @@map("autoverification_decision")
}

/// Delta check rule for one test (08 §12, A-20). Set by the lab; the middleware ships with none.
model DeltaRule {
  id            String    @id @db.Uuid
  localTestCode String    @map("local_test_code")
  /// Decimal text. At least one of the two is set. A change strictly greater is flagged.
  maxAbs        String?   @map("max_abs")
  maxPercent    String?   @map("max_percent")
  windowDays    Int       @map("window_days")
  units         String
  reference     String
  active        Boolean   @default(true)
  createdBy     String    @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  retiredBy     String?   @map("retired_by")
  retiredAt     DateTime? @map("retired_at") @db.Timestamptz
  retireReason  String?   @map("retire_reason")

  @@index([localTestCode, active])
  @@map("delta_rule")
}

/// Acceptable range for one control on one instrument and test (08 §12, A-21). Set by the lab; none shipped.
model QcRange {
  id            String     @id @db.Uuid
  instrumentId  String     @map("instrument_id")
  localTestCode String     @map("local_test_code")
  /// Null matches any lot or any name. At least one is set.
  controlLot    String?    @map("control_lot")
  controlName   String?    @map("control_name")
  /// Decimal text, inclusive.
  low           String
  high          String
  units         String
  reference     String
  /// Westgard (A-23): decimal text, both or neither. Rules need them.
  targetMean    String?    @map("target_mean")
  targetSd      String?    @map("target_sd")
  westgardRules String[]   @default([]) @map("westgard_rules")
  /// Run window for R-4s and 2-2s within the run (A-38, A-40): other controls of the test on the instrument within this many minutes are one run.
  runMinutes    Int?       @map("run_minutes")
  active        Boolean    @default(true)
  createdBy     String     @map("created_by")
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz
  retiredBy     String?    @map("retired_by")
  retiredAt     DateTime?  @map("retired_at") @db.Timestamptz
  retireReason  String?    @map("retire_reason")
  instrument    Instrument @relation(fields: [instrumentId], references: [id])

  @@index([instrumentId, localTestCode, active])
  @@map("qc_range")
}

/// The check of one QC observation, written once at intake. Append-only.
model QcEvaluation {
  id            String      @id @db.Uuid
  observationId String      @unique @map("observation_id") @db.Uuid
  instrumentId  String      @map("instrument_id")
  localTestCode String?     @map("local_test_code")
  controlLot    String?     @map("control_lot")
  controlName   String?     @map("control_name")
  controlLevel  String?     @map("control_level")
  value         Json
  units         String?
  rangeId       String?     @map("range_id") @db.Uuid
  /// IN_RANGE, OUT_OF_RANGE, RULE_VIOLATION, UNITS_DIFFER, NO_RANGE, NOT_NUMERIC
  outcome       String
  detail        String
  /// Against the range's target mean and SD, when it has them.
  zScore        Float?      @map("z_score")
  westgardReject String[]   @default([]) @map("westgard_reject")
  westgardWarn  String[]    @default([]) @map("westgard_warn")
  at            DateTime    @default(now()) @db.Timestamptz
  observation   Observation @relation(fields: [observationId], references: [id])

  @@index([instrumentId, localTestCode, at])
  @@index([rangeId, at])
  @@index([at])
  @@map("qc_evaluation")
}

/// Turnaround target from receipt in the lab to release (A-22). Set by the lab; none shipped.
model TatTarget {
  id            String    @id @db.Uuid
  /// Null applies to every test.
  localTestCode String?   @map("local_test_code")
  /// routine, urgent or stat; null applies to every priority.
  priority      String?
  minutes       Int
  reference     String
  active        Boolean   @default(true)
  createdBy     String    @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  retiredBy     String?   @map("retired_by")
  retiredAt     DateTime? @map("retired_at") @db.Timestamptz
  retireReason  String?   @map("retire_reason")

  @@index([active])
  @@map("tat_target")
}

/// The letterhead on printed lab reports (01 A-42): one row, edited by an admin.
model ReportSettings {
  /// Always "lab": there is one letterhead.
  id            String   @id @default("lab")
  labName       String   @map("lab_name")
  /// A second line under the name, such as the department.
  subtitle      String?
  address       String?
  phone         String?
  email         String?
  /// Accreditation or licence wording, printed as typed.
  accreditation String?
  /// The heading under the letterhead, such as "Laboratory report".
  reportTitle   String   @map("report_title")
  /// Extra wording printed at the foot of every report.
  footerNote    String?  @map("footer_note")
  /// PNG or JPEG, at most 256 KB, checked by its first bytes.
  logo          Bytes?
  logoType      String?  @map("logo_type")
  logoSha256    String?  @map("logo_sha256")
  updatedBy     String   @map("updated_by")
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@map("report_settings")
}

/// An outside laboratory the lab sends specimens to (01 A-43).
model ReferralLab {
  id        String         @id @db.Uuid
  /// Short code staff know it by, such as KEMRI.
  code      String         @unique
  name      String
  address   String?
  phone     String?
  email     String?
  notes     String?
  active    Boolean        @default(true)
  createdBy String         @map("created_by")
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedBy String?        @map("updated_by")
  updatedAt DateTime?      @map("updated_at") @db.Timestamptz
  tests     ReferralTest[]
  sendOuts  SendOut[]

  @@map("referral_lab")
}

/// A test a referral lab does for this lab, with its agreed turnaround.
model ReferralTest {
  id            String      @id @db.Uuid
  labId         String      @map("lab_id") @db.Uuid
  localTestCode String      @map("local_test_code")
  /// Agreed turnaround, from dispatch to the result report, in hours.
  tatHours      Int         @map("tat_hours")
  /// What to send: tube, volume, storage and transport.
  specimenNote  String?     @map("specimen_note")
  active        Boolean     @default(true)
  createdBy     String      @map("created_by")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz
  retiredBy     String?     @map("retired_by")
  retiredAt     DateTime?   @map("retired_at") @db.Timestamptz
  lab           ReferralLab @relation(fields: [labId], references: [id], onDelete: Restrict)

  @@index([localTestCode])
  @@map("referral_test")
}

/// A specimen (or part of it) sent to a referral lab, with its tests.
model SendOut {
  id            String            @id @db.Uuid
  specimenId    String            @map("specimen_id") @db.Uuid
  labId         String            @map("lab_id") @db.Uuid
  /// sent, received (by the referral lab), resulted, cancelled.
  status        String
  dispatchedAt  DateTime          @map("dispatched_at") @db.Timestamptz
  dispatchedBy  String            @map("dispatched_by")
  /// Courier, waybill or manifest number.
  dispatchRef   String?           @map("dispatch_ref")
  /// When the result report is due: dispatch plus the longest test turnaround.
  dueAt         DateTime          @map("due_at") @db.Timestamptz
  labReceivedAt DateTime?         @map("lab_received_at") @db.Timestamptz
  labReceivedBy String?           @map("lab_received_by")
  /// The referral lab's own number for the specimen.
  labRef        String?           @map("lab_ref")
  resultedAt    DateTime?         @map("resulted_at") @db.Timestamptz
  cancelledAt   DateTime?         @map("cancelled_at") @db.Timestamptz
  cancelledBy   String?           @map("cancelled_by")
  cancelReason  String?           @map("cancel_reason")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz
  specimen      Specimen          @relation(fields: [specimenId], references: [id], onDelete: Restrict)
  lab           ReferralLab       @relation(fields: [labId], references: [id], onDelete: Restrict)
  tests         SendOutTest[]
  documents     SendOutDocument[]

  @@index([status, dueAt])
  @@index([specimenId])
  @@map("send_out")
}

/// One ordered test on a send-out. An ordered test is on at most one send-out that is not cancelled.
model SendOutTest {
  id            String      @id @db.Uuid
  sendOutId     String      @map("send_out_id") @db.Uuid
  orderedTestId String      @map("ordered_test_id") @db.Uuid
  tatHours      Int         @map("tat_hours")
  /// False once the send-out is cancelled, so the test can be sent again.
  active        Boolean     @default(true)
  sendOut       SendOut     @relation(fields: [sendOutId], references: [id], onDelete: Restrict)
  orderedTest   OrderedTest @relation(fields: [orderedTestId], references: [id], onDelete: Restrict)

  @@index([orderedTestId])
  @@map("send_out_test")
}

/// A file kept with a send-out: the referral lab's receiving report, its result report, or another paper.
model SendOutDocument {
  id          String   @id @db.Uuid
  sendOutId   String   @map("send_out_id") @db.Uuid
  /// receiving-report, result-report or other.
  kind        String
  fileName    String   @map("file_name")
  contentType String   @map("content_type")
  bytes       Bytes
  size        Int
  sha256      String
  note        String?
  uploadedBy  String   @map("uploaded_by")
  uploadedAt  DateTime @default(now()) @map("uploaded_at") @db.Timestamptz
  sendOut     SendOut  @relation(fields: [sendOutId], references: [id], onDelete: Restrict)

  @@index([sendOutId])
  @@map("send_out_document")
}
