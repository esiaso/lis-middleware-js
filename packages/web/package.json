{
  "name": "@lis/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "lims-web": "dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./oidc": {
      "types": "./dist/oidc.d.ts",
      "default": "./dist/oidc.js"
    },
    "./ldap": {
      "types": "./dist/ldap.d.ts",
      "default": "./dist/ldap.js"
    }
  },
  "files": [
    "dist",
    "views",
    "public"
  ],
  "dependencies": {
    "@lis/contracts": "0.1.0",
    "@lis/db": "0.1.0",
    "@lis/domain": "0.1.0",
    "@lis/lab": "0.1.0",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "bootstrap": "5.3.8",
    "bootstrap-icons": "1.13.2",
    "bwip-js": "4.11.4",
    "cookie-parser": "1.4.7",
    "hbs": "4.4.0",
    "ldapts": "9.2.0",
    "multer": "2.5.0",
    "openid-client": "6.8.8",
    "pino": "10.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "jose": "6.2.13"
  }
}
