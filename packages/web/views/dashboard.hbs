<div class="d-flex align-items-center gap-2 mb-3"><h1 class="h4 mb-0">Dashboard</h1><span class="small text-body-secondary ms-auto">Refreshes every minute</span></div>
{{#if critical}}<div class="alert alert-danger dash-banner d-flex align-items-center gap-3" role="alert">{{icon "exclamation-triangle-fill"}}<div><strong>{{critical.n}}{{#if critical.more}}+{{/if}} critical result{{#unless (eq critical.n 1)}}s{{/unless}} not yet called</strong> <span>oldest waiting {{critical.oldest}}{{#if critical.late}}, <strong>{{critical.late}} past the call target</strong>{{/if}}</span></div> <a class="btn btn-danger btn-sm ms-auto" href="/critical">Open</a></div>{{/if}}
{{#if hmis}}<div class="alert alert-warning dash-banner d-flex align-items-center gap-3" role="alert">{{icon "hospital"}}<div><strong>HMIS link</strong> <span>{{hmis}}</span></div> <a class="btn btn-outline-dark btn-sm ms-auto" href="/hmis">Open</a></div>{{/if}}
{{#if qcFailing}}<div class="alert alert-warning dash-banner d-flex align-items-center gap-3" role="alert">{{icon "graph-down-arrow"}}<div><strong>QC failed: {{qcFailing.n}}</strong> <span>{{qcFailing.list}}</span></div> <a class="btn btn-outline-dark btn-sm ms-auto" href="/qc">Open</a></div>{{/if}}
{{#if overdue}}<div class="alert alert-warning dash-banner d-flex align-items-center gap-3" role="alert">{{icon "stopwatch"}}<div><strong>{{overdue.n}} result{{#unless (eq overdue.n 1)}}s{{/unless}} past the turnaround target</strong> <span>most late by {{overdue.oldest}}</span></div> <a class="btn btn-outline-dark btn-sm ms-auto" href="/reports/overdue">Open</a></div>{{/if}}
{{#if downtime}}<div class="alert alert-warning dash-banner d-flex align-items-center gap-3" role="alert">{{icon "cloud-slash"}}<div><strong>{{downtime.n}} downtime order{{#unless (eq downtime.n 1)}}s{{/unless}} to reconcile</strong> <span>their results are held from the HMIS</span></div> <a class="btn btn-outline-dark btn-sm ms-auto" href="/downtime">Open</a></div>{{/if}}
{{#unless critical}}{{#unless hmis}}{{#unless qcFailing}}{{#unless overdue}}{{#unless downtime}}<div class="alert alert-light border dash-banner d-flex align-items-center gap-3 text-body-secondary" role="status">{{icon "check2-circle"}}<span>No critical calls, QC failures, late results or HMIS link problems right now.</span></div>{{/unless}}{{/unless}}{{/unless}}{{/unless}}{{/unless}}
<div class="row row-cols-2 row-cols-md-3 row-cols-xl-5 g-3 mb-4">
  {{#each tiles}}
  <div class="col">
    <a class="card dash-tile text-decoration-none text-body h-100 {{tone}}" href="{{href}}">
      <div class="card-body d-flex gap-3 align-items-start">
        <span class="dash-icon">{{icon icon}}</span>
        <div><div class="dash-n">{{n}}</div><div class="fw-semibold">{{label}}</div><div class="small text-body-secondary">{{hint}}</div></div>
      </div>
    </a>
  </div>
  {{/each}}
</div>
<div class="card">
<div class="card-header d-flex align-items-center gap-2 bg-body-tertiary">{{icon "cpu"}}<h2 class="h6 mb-0">Instruments</h2><a class="small ms-auto" href="/instruments">All instruments</a></div>
<div class="table-responsive">
<table class="table table-sm align-middle mb-0">
  <thead><tr><th>Instrument</th><th>Model</th><th>Link</th><th>Verification</th><th>Clinical use</th></tr></thead>
  <tbody>
    {{#each instruments}}
    <tr>
      <td><a href="{{href}}">{{name}}</a> <span class="text-body-secondary small">{{id}}</span></td>
      <td>{{model}}</td>
      <td>{{#if linked}}<span class="badge text-bg-success">connected</span>{{else}}<span class="badge text-bg-secondary">no worker</span>{{/if}}</td>
      <td>{{verification}}</td>
      <td>{{#if clinical}}<span class="badge text-bg-success">cleared</span>{{else}}<span class="badge text-bg-warning" title="{{gateDetail}}">not for clinical use</span> <span class="small text-body-secondary">{{gateDetail}}</span>{{/if}}</td>
    </tr>
    {{else}}
    <tr><td colspan="5" class="text-body-secondary">No instruments registered yet.</td></tr>
    {{/each}}
  </tbody>
</table>
</div>
</div>
