<h1 class="h4 mb-3">Dashboard</h1>
{{#if hmis}}<div class="alert alert-warning d-flex align-items-center gap-3" role="alert"><strong>HMIS link</strong> <span>{{hmis}}</span> <a class="btn btn-outline-dark btn-sm ms-auto" href="/hmis">Open</a></div>{{/if}}
{{#if overdue}}<div class="alert alert-warning d-flex align-items-center gap-3" role="alert"><strong>{{overdue.n}} result{{#unless (eq overdue.n 1)}}s{{/unless}} past the turnaround target</strong> <span>most late by {{overdue.oldest}}</span> <a class="btn btn-outline-dark btn-sm ms-auto" href="/reports/overdue">Open</a></div>{{/if}}
{{#if qcFailing}}<div class="alert alert-warning d-flex align-items-center gap-3" role="alert"><strong>QC failed: {{qcFailing.n}}</strong> <span>{{qcFailing.list}}</span> <a class="btn btn-outline-dark btn-sm ms-auto" href="/qc">Open</a></div>{{/if}}
{{#if critical}}<div class="alert alert-danger d-flex align-items-center gap-3" role="alert"><strong>&#9650; {{critical.n}}{{#if critical.more}}+{{/if}} critical result{{#unless (eq critical.n 1)}}s{{/unless}} not yet called</strong> <span>oldest waiting {{critical.oldest}}</span> <a class="btn btn-danger btn-sm ms-auto" href="/critical">Open</a></div>{{/if}}
<div class="row g-3 mb-4">
  {{#each tiles}}
  <div class="col-6 col-md">
    <a class="card text-decoration-none h-100 {{#if alert}}{{#if n}}border-danger{{/if}}{{/if}}" href="{{href}}">
      <div class="card-body">
        <div class="display-6">{{n}}</div>
        <div class="text-body-secondary">{{label}}</div>
      </div>
    </a>
  </div>
  {{/each}}
</div>
<h2 class="h5">Instruments</h2>
<table class="table table-sm align-middle">
  <thead><tr><th>Instrument</th><th>Model</th><th>Link</th><th>Verification</th><th>Clinical use</th></tr></thead>
  <tbody>
    {{#each instruments}}
    <tr>
      <td><a href="{{href}}">{{name}}</a> <span class="text-body-secondary small">{{id}}</span></td>
      <td>{{model}}</td>
      <td>{{#if linked}}<span class="badge text-bg-success">connected</span>{{else}}<span class="badge text-bg-secondary">no worker</span>{{/if}}</td>
      <td>{{verification}}</td>
      <td>{{#if clinical}}<span class="badge text-bg-success">cleared</span>{{else}}<span class="badge text-bg-warning" title="{{gateDetail}}">not for clinical use</span> <span class="small text-body-secondary">{{gateDetail}}</span>{{/if}}</td>
    </tr>
    {{else}}
    <tr><td colspan="5" class="text-body-secondary">No instruments registered yet.</td></tr>
    {{/each}}
  </tbody>
</table>
