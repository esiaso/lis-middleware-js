<h1 class="h4">Change {{f.displayName}}</h1>
<div class="alert alert-warning" role="note">Changing the manufacturer, model, serial number, software version, driver or driver options resets the instrument to <strong>unverified</strong> and turns it off. Changing only the connection keeps the status but needs a link re-test. Current status: {{status}}.</div>
{{> issues}}
<form method="post" action="/instruments/{{f.instrumentId}}/edit">
  <input type="hidden" name="_csrf" value="{{csrf}}">
  <input type="hidden" name="rowVersion" value="{{rowVersion}}">
  {{> instrument-fields locked=true}}
  <button class="btn btn-primary" type="submit">Save changes</button>
</form>
