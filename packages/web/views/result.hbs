<p><a href="/results">&larr; Results</a></p>
<h1 class="h4">{{test.local}} <span class="text-body-secondary small">HMIS {{test.hmis}}</span></h1>
<p class="mb-1"><strong><a href="/patients/{{patientId}}">{{patient}}</a></strong> · order {{order.hmisOrderId}} ({{order.priority}}, {{order.orderedAt}})</p>
<p class="mb-3">{{#if specimen}}Accession {{specimen.accessionNo}}{{#if specimen.collectedAt}}, collected {{specimen.collectedAt}}{{/if}}{{/if}}
  {{#if instrument}} · {{instrument.name}} ({{instrument.model}}){{else}} · manual entry{{#if manual}}: performed by {{manual.performedBy}}{{#if manual.lot}}, lot {{manual.lot}}{{/if}}, entered by {{manual.enteredBy}}{{#if manual.qcProblem}} · <span class="badge text-bg-warning">QC {{manual.qcProblem}}</span>{{/if}}{{#if manual.qcPassed}} · QC passed{{/if}}{{/if}}{{/if}}</p>

{{#if notClinical}}<div class="alert alert-warning" role="alert"><strong>Not for clinical use.</strong> This instrument is not cleared: {{notClinical}}. The result cannot be released.</div>{{/if}}
{{#if downtime}}<div class="alert alert-warning" role="alert"><strong>Downtime order {{downtime.id}}.</strong> This result can be reviewed and approved, but it is held from the HMIS until the order is <a href="/downtime/{{downtime.orderId}}">reconciled to the HMIS order</a>.</div>{{/if}}
{{#if r.newDataAfterApproval}}<div class="alert alert-warning" role="alert">A new value arrived from the instrument after approval. Decide whether a correction is needed.</div>{{/if}}
{{#if r.needsConfirmation}}<div class="alert alert-info" role="status">The last delivery had no clear answer. The middleware is checking with the HMIS before any resend.</div>{{/if}}

{{#if critical}}
<div class="alert alert-danger" role="alert">
  {{#each critical}}<p class="mb-1"><strong>&#9650; Critical result</strong>, version {{no}}: <span class="font-monospace">{{value}} {{units}}</span>, {{detail}}. Waiting {{waiting}} for a call.</p>{{/each}}
  <p class="mb-0 small">Phone the ward or the clinician now, ask them to read the value back, and record it below. It cannot be approved until then.</p>
</div>
{{#if can.call}}
<form method="post" action="/results/{{r.id}}/critical-call" class="card card-body border-danger mb-3">
  <input type="hidden" name="_csrf" value="{{csrf}}">
  <h2 class="h6">Record the call</h2>
  <div class="row g-2">
    <div class="col-md-2"><label class="form-label" for="call-version">Version</label>
      <select class="form-select" id="call-version" name="versionNo">{{#each critical}}<option value="{{no}}">#{{no}}: {{value}} {{units}}</option>{{/each}}</select></div>
    <div class="col-md-3"><label class="form-label" for="notified">Person told</label><input class="form-control" id="notified" name="notified" required minlength="2" maxlength="80"></div>
    <div class="col-md-3"><label class="form-label" for="notifiedRole">Their role and ward</label><input class="form-control" id="notifiedRole" name="notifiedRole" required minlength="2" maxlength="80" placeholder="for example ward nurse, Ward 3"></div>
    <div class="col-md-2"><label class="form-label" for="minutesAgo">Told how many minutes ago</label><input class="form-control" id="minutesAgo" name="minutesAgo" value="0" inputmode="numeric" pattern="\d{1,4}"></div>
    <div class="col-md-8"><label class="form-label" for="note">Note (optional)</label><input class="form-control" id="note" name="note" maxlength="500" placeholder="for example earlier attempts, doctor paged"></div>
    <div class="col-12"><div class="form-check"><input class="form-check-input" type="checkbox" id="readBack" name="readBack" value="yes" required><label class="form-check-label" for="readBack">They read the patient's name and the value back to me correctly.</label></div></div>
    <div class="col-12"><button class="btn btn-danger" type="submit">Record the call</button></div>
  </div>
</form>
{{/if}}
{{/if}}

<p>Status: <strong>{{r.status}}</strong>{{#if r.autoverified}} · <span class="badge text-bg-success">autoverified</span> approved by the lab's autoverification rule, waiting for a person to release{{else}}{{#if r.reviewedBy}} · reviewed by {{r.reviewedBy}}{{/if}}{{#if r.approvedBy}} · approved by {{r.approvedBy}}{{/if}}{{/if}}</p>

{{#if reference}}{{#if reference.text}}<p class="small mb-2">Reference range: <strong class="font-monospace">{{reference.text}}</strong> {{#if reference.lab}}(the lab's range for {{reference.who}}; {{reference.source}}){{else}}(sent by the instrument){{/if}}</p>{{/if}}{{/if}}
<h2 class="h6">Versions</h2>
<table class="table table-sm">
  <thead><tr><th>#</th><th>Kind</th><th>Value</th><th>Flags</th><th>By</th><th>At</th><th>Reason</th></tr></thead>
  <tbody>
    {{#each versions}}
    <tr class="{{#if selected}}table-primary{{/if}}">
      <td>{{no}}{{#if selected}} (selected){{/if}}</td><td>{{kind}}</td><td class="font-monospace">{{value}} {{units}}</td><td>{{flags}}{{#if mark}} <span class="badge text-bg-info">{{mark}}</span>{{/if}}{{#if critical}} <span class="badge text-bg-danger">critical {{critical}}</span>{{#if called}} <span class="badge text-bg-secondary">called</span>{{/if}}{{/if}}{{#if unitsDiffer}} <span class="badge text-bg-warning" title="{{unitsDiffer}}">limit not checked: units differ</span>{{/if}}{{#if delta}}<div class="small mt-1">{{#if delta.exceeded}}<span class="badge text-bg-warning">delta</span>{{else}}<span class="badge text-bg-secondary">delta not checked</span>{{/if}} {{delta.detail}}{{#if delta.previous}} · <a href="{{delta.previous}}">previous result</a>{{/if}}</div>{{/if}}</td><td>{{by}}</td><td class="small">{{at}}</td><td>{{reason}}</td>
    </tr>
    {{/each}}
  </tbody>
</table>

<div class="row g-3 mb-4">
  {{#if actions.review}}{{#if can.review}}
  <div class="col-md-6 col-lg-4">
    <form method="post" action="/results/{{r.id}}/review" class="card card-body">
      <input type="hidden" name="_csrf" value="{{csrf}}">
      <label class="form-label" for="versionNo">Version to report</label>
      <select class="form-select mb-2" id="versionNo" name="versionNo">
        {{#each versions}}<option value="{{no}}" {{#if selected}}selected{{/if}}>#{{no}} {{kind}}: {{value}} {{units}}</option>{{/each}}
      </select>
      <button class="btn btn-primary" type="submit">Mark reviewed</button>
    </form>
  </div>
  {{/if}}{{/if}}

  {{#if actions.approve}}{{#if can.approve}}
  <div class="col-md-6 col-lg-4">
    <form method="post" action="/results/{{r.id}}/approve" class="card card-body">
      <input type="hidden" name="_csrf" value="{{csrf}}">
      {{#if twoPersonRule}}<p class="small text-body-secondary">The approver must be a different person from the reviewer.</p>{{/if}}
      {{> confirm id="approve-password" label="Your password" labelClass="form-label" inputClass="form-control mb-2"}}
      <button class="btn btn-primary" type="submit">Approve</button>
    </form>
  </div>
  {{/if}}{{/if}}

  {{#if actions.release}}{{#if can.approve}}
  <div class="col-md-6 col-lg-4">
    <form method="post" action="/results/{{r.id}}/release" class="card card-body">
      <input type="hidden" name="_csrf" value="{{csrf}}">
      {{> confirm id="release-password" label="Your password" labelClass="form-label" inputClass="form-control mb-2"}}
      <button class="btn btn-success" type="submit">Release to HMIS</button>
    </form>
  </div>
  {{/if}}{{/if}}

  {{#if actions.replay}}{{#if can.replay}}
  <div class="col-md-6 col-lg-4">
    <form method="post" action="/results/{{r.id}}/replay" class="card card-body">
      <input type="hidden" name="_csrf" value="{{csrf}}">
      <label class="form-label" for="replay-reason">Reason for sending again</label>
      <input class="form-control mb-2" id="replay-reason" name="reason" minlength="5" required>
      <button class="btn btn-warning" type="submit">Send again</button>
    </form>
  </div>
  {{/if}}{{/if}}

  {{#if actions.correct}}{{#if can.approve}}
  <div class="col-md-6 col-lg-4">
    <form method="post" action="/results/{{r.id}}/correct" class="card card-body">
      <input type="hidden" name="_csrf" value="{{csrf}}">
      <label class="form-label" for="value">Corrected value</label>
      <input class="form-control mb-2" id="value" name="value" required>
      <label class="form-label" for="units">Units</label>
      <input class="form-control mb-2" id="units" name="units">
      <label class="form-label" for="reason">Reason (at least 10 characters)</label>
      <input class="form-control mb-2" id="reason" name="reason" minlength="10" required>
      {{> confirm id="correct-password" label="Your password" labelClass="form-label" inputClass="form-control mb-2"}}
      <button class="btn btn-danger" type="submit">Save correction</button>
    </form>
  </div>
  {{/if}}{{/if}}
</div>

{{#each autoverify}}
<div class="card card-body mb-3 small {{#if passed}}border-success{{/if}}">
  <p class="mb-1"><strong>{{#if passed}}Autoverified{{else}}Left for a person by autoverification{{/if}}</strong>, version {{version}}, {{at}}, under the rule validated in {{reference}}.</p>
  {{#if failed}}<p class="mb-1">Checks that did not pass:</p><ul class="mb-1">{{#each failed}}<li>{{check}}: {{detail}}</li>{{/each}}</ul>{{/if}}
  <details><summary>All checks</summary><ul class="mb-0">{{#each checks}}<li>{{#if ok}}&#10003;{{else}}&#10007;{{/if}} {{check}}: {{detail}}</li>{{/each}}</ul></details>
</div>
{{/each}}

{{#if calls}}
<h2 class="h6">Critical result calls</h2>
<ul class="list-unstyled small">
  {{#each calls}}<li>v{{version}} · told {{notified}} ({{role}}) at {{at}}, read back · recorded by {{by}} at {{recordedAt}}{{#if note}} · {{note}}{{/if}}</li>{{/each}}
</ul>
{{/if}}

<div class="d-flex align-items-baseline gap-3"><h2 class="h6">Comments</h2><a class="small" href="/standard-comments">Standard comments</a></div>
<ul class="list-unstyled small">
  {{#each comments}}
  <li class="mb-2{{#if withdrawn}} text-body-secondary{{/if}}">
    {{#if withdrawn}}<s>{{text}}</s>{{else}}{{text}}{{/if}}
    {{#if onReport}}<span class="badge text-bg-primary">on the report</span>{{else}}<span class="badge text-bg-secondary">lab only</span>{{/if}}
    <span class="text-body-secondary">· {{by}}, {{at}}</span>
    {{#if withdrawn}}<div>Withdrawn by {{withdrawn.by}}, {{withdrawn.at}}: {{withdrawn.reason}}</div>{{else}}{{#if @root.can.review}}
    <details class="d-inline-block ms-2"><summary>Withdraw</summary>
      <form method="post" action="/results/{{@root.r.id}}/comments/{{id}}/withdraw" class="d-flex gap-2 mt-1">
        <input type="hidden" name="_csrf" value="{{@root.csrf}}">
        <input class="form-control form-control-sm" name="reason" minlength="5" required placeholder="Reason" aria-label="Reason">
        <button class="btn btn-outline-danger btn-sm" type="submit">Withdraw</button>
      </form>
    </details>{{/if}}{{/if}}
  </li>
  {{else}}
  <li class="text-body-secondary">No comments.</li>
  {{/each}}
</ul>
{{#if can.review}}
<form method="post" action="/results/{{r.id}}/comments" class="card card-body mb-4">
  <input type="hidden" name="_csrf" value="{{csrf}}">
  {{#if standardComments}}
  <label class="form-label" for="comment-standard">Standard comment</label>
  <select class="form-select mb-2" id="comment-standard" name="standard"><option value="">None, I'll type one</option>{{#each standardComments}}<option value="{{id}}">{{code}}: {{text}}</option>{{/each}}</select>
  <label class="form-label" for="comment-text">Or type a comment</label>
  <textarea class="form-control mb-2" id="comment-text" name="text" rows="2" maxlength="500"></textarea>
  {{else}}
  <label class="form-label" for="comment-text">Add a comment</label>
  <textarea class="form-control mb-2" id="comment-text" name="text" rows="2" minlength="2" maxlength="500" required></textarea>
  {{/if}}
  {{#if can.approve}}<div class="form-check mb-2"><input class="form-check-input" type="checkbox" id="comment-report" name="onReport" value="yes"><label class="form-check-label" for="comment-report">Print it on the result report under the value</label></div>{{else}}<p class="small text-body-secondary">Comments you add are for the lab only; an approver can add one to the printed report.</p>{{/if}}
  <div><button class="btn btn-outline-primary btn-sm" type="submit">Add comment</button></div>
</form>
{{/if}}

<h2 class="h6">History</h2>
<ul class="list-unstyled small">
  {{#each events}}<li>{{at}} · {{kind}}{{#if version}} v{{version}}{{/if}} · {{actor}}{{#if reason}} · {{reason}}{{/if}}</li>{{else}}<li class="text-body-secondary">No decisions yet.</li>{{/each}}
</ul>
