<div class="page-head d-flex flex-wrap align-items-center gap-2 d-print-none">
  <h1 class="h4 mb-0">Report {{o.hmisOrderId}}</h1>
  <button class="btn btn-primary btn-sm ms-auto d-inline-flex align-items-center gap-1" type="button" data-print>{{icon "printer"}}<span>Print</span></button>
</div>
<div class="d-print-none mb-3">
  <p class="small text-body-secondary mb-2">Print with the button or Ctrl+P. Only approved results carry a value; the rest print as pending.</p>
  {{#unless approved}}<div class="alert alert-warning">No result on this order is approved yet, so the report has no values.</div>{{/unless}}
</div>
<article class="result-report">
  <header class="report-letterhead">
    <div>
      <div class="report-lab">{{header}}</div>
      <div class="report-kind">Laboratory report</div>
    </div>
    <div class="report-ids">
      <div><span>Order</span> <strong>{{o.hmisOrderId}}</strong>{{#if o.downtime}} (downtime order){{/if}}</div>
      <div><span>Priority</span> {{o.priority}}</div>
    </div>
  </header>
  <section class="report-boxes">
    <div class="report-box">
      <div class="report-box-title">Patient</div>
      <div class="report-patient">{{patient.name}}{{#if patient.provisional}} <span class="small">(provisional record)</span>{{/if}}</div>
      <dl>
        <dt>MRN</dt><dd>{{patient.mrn}}</dd>
        {{#if patient.sex}}<dt>Sex</dt><dd>{{patient.sex}}</dd>{{/if}}
        {{#if patient.birthDate}}<dt>Born</dt><dd>{{patient.birthDate}}</dd>{{/if}}
      </dl>
    </div>
    <div class="report-box">
      <div class="report-box-title">Request</div>
      <dl>
        {{#if o.location}}<dt>Location</dt><dd>{{o.location}}</dd>{{/if}}
        {{#if o.clinician}}<dt>Clinician</dt><dd>{{o.clinician}}</dd>{{/if}}
        <dt>Ordered</dt><dd>{{o.orderedAt}}</dd>
      </dl>
    </div>
  </section>
  {{#if specimens}}
  <table class="table table-sm small report-specimens">
    <thead><tr><th>Specimen</th><th>Type</th><th>Collected</th><th>Received</th></tr></thead>
    <tbody>{{#each specimens}}<tr><td>{{accessionNo}}{{#if rejected}} (rejected){{/if}}</td><td>{{type}}</td><td>{{collected}}</td><td>{{received}}</td></tr>{{/each}}</tbody>
  </table>
  {{/if}}
  <table class="table table-sm report-results">
    <thead><tr><th>Test</th><th>Result</th><th>Units</th><th>Flag</th><th>Reference range</th><th>Approved</th></tr></thead>
    <tbody>
      {{#each lines}}
      <tr class="{{#if critical}}report-critical{{/if}}">
        <td>{{test}}{{#if hmisTestCode}} <span class="text-body-secondary small">({{hmisTestCode}})</span>{{/if}}</td>
        {{#if approved}}
        <td class="font-monospace fw-semibold">{{value}}{{#if corrected}} <span class="small fw-normal">(corrected)</span>{{/if}}</td><td>{{units}}</td><td>{{flags}}{{#if mark}} {{mark}}{{/if}}{{#if critical}} <strong>CRITICAL{{#unless (eq critical "answer")}} {{critical}}{{/unless}}</strong>{{/if}}</td><td class="small">{{referenceRange}}{{#if rangeSource}} <span class="text-body-secondary">({{rangeSource}})</span>{{/if}}</td><td class="small">{{approvedBy}}<br>{{approvedAt}}</td>
        {{else}}
        <td colspan="5" class="text-body-secondary">{{#if cancelled}}Cancelled{{else}}Pending{{/if}}</td>
        {{/if}}
      </tr>
      {{#if comments}}<tr class="report-comment"><td></td><td colspan="5" class="small">{{#each comments}}<div>Comment: {{this}}</div>{{/each}}</td></tr>{{/if}}
      {{/each}}
    </tbody>
  </table>
  <footer class="report-footer">
    <p class="mb-1">Values as reported by the instrument and approved in the laboratory. {{#if pending}}Pending tests have no approved result yet; do not act on them from this report. {{/if}}The HMIS record is the official result where it has been received.</p>
    <p class="mb-0">Printed {{printed}} by {{printedBy}}</p>
  </footer>
</article>
