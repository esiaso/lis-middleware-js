<div class="d-flex align-items-baseline gap-3"><h1 class="h4">Workload</h1><a href="/reports/turnaround">Turnaround times</a></div>
<p class="text-body-secondary">What the instruments measured, counted from the values they sent, by the day their message arrived (UTC). A measurement is an instrument value stored on a patient result; values typed or corrected by a person are not counted. A repeat is any measurement after the first on the same result. QC counts the QC results in the QC log. Quarantined counts patient values that arrived with no matching order; any attached to an order later are also in the measurements, so it is not added to the total.</p>
{{> issues}}
<form method="get" action="/reports/workload" class="row g-2 align-items-end mb-3">
  <div class="col-auto"><label class="form-label small" for="from">From</label><input class="form-control form-control-sm" type="date" id="from" name="from" value="{{from}}"></div>
  <div class="col-auto"><label class="form-label small" for="to">To (included)</label><input class="form-control form-control-sm" type="date" id="to" name="to" value="{{to}}"></div>
  <div class="col-auto"><button class="btn btn-outline-secondary btn-sm" type="submit">Show</button></div>
  {{#if can.exportReports}}<div class="col-auto ms-auto"><a class="btn btn-outline-primary btn-sm" href="{{csv}}">Download CSV</a></div>{{/if}}
</form>

{{#if empty}}
<p class="text-body-secondary">Nothing arrived from the instruments in this range.</p>
{{else}}
<h2 class="h6">By instrument</h2>
<table class="table table-sm align-middle">
  <thead><tr><th>Instrument</th><th class="text-end">Measurements</th><th class="text-end">of which repeats</th><th class="text-end">QC</th><th class="text-end">Quarantined</th></tr></thead>
  <tbody>
    {{#each w.instruments}}<tr><td>{{name}}</td><td class="text-end">{{measurements}}</td><td class="text-end">{{repeats}}</td><td class="text-end">{{qc}}</td><td class="text-end">{{quarantined}}</td></tr>{{/each}}
    {{#with w.total}}<tr class="fw-semibold"><td>All instruments</td><td class="text-end">{{measurements}}</td><td class="text-end">{{repeats}}</td><td class="text-end">{{qc}}</td><td class="text-end">{{quarantined}}</td></tr>{{/with}}
  </tbody>
</table>

{{#if tests}}
<h2 class="h6 mt-4">By test</h2>
<div class="table-responsive">
<table class="table table-sm align-middle">
  <thead><tr><th>Test</th><th class="text-end">Measurements</th><th class="text-end">Repeats</th>{{#each testColumns}}<th class="text-end">{{name}}</th>{{/each}}</tr></thead>
  <tbody>
    {{#each tests}}<tr><td class="font-monospace">{{test}}</td><td class="text-end">{{measurements}}</td><td class="text-end">{{repeats}}</td>{{#each cells}}<td class="text-end">{{this}}</td>{{/each}}</tr>{{/each}}
  </tbody>
</table>
</div>
{{/if}}

<h2 class="h6 mt-4">By day</h2>
<table class="table table-sm align-middle">
  <thead><tr><th>Day (UTC)</th><th class="text-end">Measurements</th><th class="text-end">Repeats</th><th class="text-end">QC</th></tr></thead>
  <tbody>
    {{#each w.days}}<tr><td>{{day}}</td><td class="text-end">{{measurements}}</td><td class="text-end">{{repeats}}</td><td class="text-end">{{qc}}</td></tr>{{/each}}
  </tbody>
</table>
{{/if}}
