<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h4 mb-0">Instruments</h1>
  {{#if can.register}}<a class="btn btn-primary btn-sm" href="/instruments/new">Register instrument</a>{{/if}}
</div>
<table class="table table-sm align-middle">
  <thead><tr><th>Instrument</th><th>Model</th><th>Software</th><th>Verification</th><th>Link</th></tr></thead>
  <tbody>
    {{#each rows}}
    <tr><td><a href="{{href}}">{{name}}</a> <span class="small text-body-secondary">{{id}}</span></td><td>{{model}}</td><td>{{software}}</td><td>{{verification}}</td><td>{{#if enabled}}on{{else}}off{{/if}}</td></tr>
    {{else}}
    <tr><td colspan="5" class="text-body-secondary">No instruments registered yet.</td></tr>
    {{/each}}
  </tbody>
</table>
