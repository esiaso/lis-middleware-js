<div class="d-flex align-items-baseline gap-3 mb-3"><h1 class="h4 mb-0">Results</h1><a href="/reference-ranges">Reference ranges</a><a href="/standard-comments">Standard comments</a></div>
<form method="get" action="/results" class="list-search d-print-none" role="search">
  {{#if filter}}<input type="hidden" name="status" value="{{filter}}">{{/if}}
  <label class="visually-hidden" for="q">Search results</label>
  <input class="form-control" id="q" name="q" value="{{q}}" placeholder="Accession, MRN, name, order or test code" maxlength="60">
  <button class="btn btn-primary" type="submit">Search</button>
  {{#if q}}<a class="btn btn-link" href="{{#if filter}}/results?status={{filter}}{{else}}/results{{/if}}">Clear</a>{{/if}}
</form>
<div class="mb-3 d-flex flex-wrap gap-1 status-pills">
  <a class="btn btn-sm {{#if filter}}btn-outline-secondary{{else}}btn-primary{{/if}}" href="{{allHref}}">All <span class="pill-count">{{all}}</span></a>
  {{#each statuses}}
  <a class="btn btn-sm {{#if active}}btn-primary{{else}}btn-outline-secondary{{/if}}" href="{{href}}">{{label}} <span class="pill-count">{{count}}</span></a>
  {{/each}}
</div>
<table class="table table-sm table-hover align-middle">
  <thead><tr><th>Patient</th><th>Accession</th><th>Test</th><th>Value</th><th>Flags</th><th>Status</th><th>Updated</th></tr></thead>
  <tbody>
    {{#each rows}}
    <tr>
      <td><a href="/results/{{id}}">{{patient}}</a></td>
      <td>{{accessionNo}}</td>
      <td>{{test}}</td>
      <td class="font-monospace">{{value}} {{units}}</td>
      <td>{{flags}}{{#if critical}} <span class="badge text-bg-danger">critical {{critical}}</span>{{/if}}{{#if delta}} <span class="badge text-bg-warning" title="{{delta}}">delta</span>{{/if}}</td>
      <td><span class="badge text-bg-{{statusTone}}">{{status}}</span>{{#if attention}} <span class="badge text-bg-warning">needs attention</span>{{/if}}</td>
      <td class="small">{{updated}}</td>
    </tr>
    {{else}}
    <tr><td colspan="7" class="text-body-secondary">{{#if q}}No results match “{{q}}”.{{else}}No results.{{/if}}</td></tr>
    {{/each}}
  </tbody>
</table>
{{> pager}}
