<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
  <h1 class="h4 mb-0">Orders</h1>
  <form method="get" action="/orders" class="d-flex gap-2" role="search">
    <input type="hidden" name="filter" value="{{filter}}">
    <label class="visually-hidden" for="q">Search</label>
    <input class="form-control form-control-sm" id="q" name="q" value="{{q}}" placeholder="Accession, MRN, name or HMIS order" autofocus>
    <div class="form-check align-self-center text-nowrap">
      <input class="form-check-input" type="checkbox" id="stat" name="stat" value="1" {{#if stat}}checked{{/if}}>
      <label class="form-check-label" for="stat">STAT only</label>
    </div>
    <button class="btn btn-outline-primary btn-sm" type="submit">Search</button>
  </form>
</div>
<ul class="nav nav-tabs mb-3">
  {{#each filters}}<li class="nav-item"><a class="nav-link{{#if active}} active{{/if}}" {{#if active}}aria-current="page"{{/if}} href="/orders?filter={{value}}">{{label}}</a></li>{{/each}}
</ul>
<table class="table table-sm align-middle">
  <thead><tr><th>Priority</th><th>Patient</th><th>HMIS order</th><th>Tests</th><th>To collect</th><th>Ordered</th></tr></thead>
  <tbody>
    {{#each rows}}
    <tr class="{{#if cancelled}}text-body-secondary{{/if}}">
      <td>{{#if stat}}<span class="badge text-bg-danger">STAT</span>{{else}}{{priority}}{{/if}}</td>
      <td><strong>{{patient.name}}</strong> <span class="small">MRN {{patient.mrn}}</span></td>
      <td><a href="/orders/{{id}}">{{hmisOrderId}}</a>{{#if cancelled}} (cancelled){{/if}}{{#if downtime}} <span class="badge text-bg-warning">downtime</span>{{/if}}{{#if reconciled}} (reconciled){{/if}}</td>
      <td class="font-monospace small">{{tests}}</td>
      <td>{{pending}}</td>
      <td class="small">{{orderedAt}}</td>
    </tr>
    {{else}}
    <tr><td colspan="6" class="text-body-secondary">No orders match.</td></tr>
    {{/each}}
  </tbody>
</table>
