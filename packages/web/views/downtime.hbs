<div class="d-flex justify-content-between align-items-center mb-2">
  <h1 class="h4 mb-0">Downtime orders</h1>
  {{#if can.collect}}<a class="btn btn-primary btn-sm" href="/downtime/new">Downtime registration</a>{{/if}}
</div>
<p class="text-body-secondary">Orders registered by hand while the HMIS could not be reached. Their results are held from the HMIS until each is reconciled to the HMIS order.</p>
<table class="table table-sm align-middle">
  <thead><tr><th>Downtime order</th><th>Provisional patient</th><th>Tests</th><th>Registered</th><th>Reconciliation</th></tr></thead>
  <tbody>
    {{#each rows}}
    <tr>
      <td><a class="font-monospace" href="/orders/{{id}}">{{downtimeId}}</a></td>
      <td>{{patient}}{{#if birthDate}} <span class="small">born {{birthDate}}</span>{{/if}}</td>
      <td class="font-monospace small">{{tests}}</td>
      <td class="small">{{at}}</td>
      <td>{{#if reconciled}}done by {{reconciledBy}}{{else}}<a class="btn btn-outline-warning btn-sm" href="/downtime/{{id}}">Reconcile</a>{{/if}}</td>
    </tr>
    {{else}}
    <tr><td colspan="5" class="text-body-secondary">No downtime orders.</td></tr>
    {{/each}}
  </tbody>
</table>
