<div class="login-split">
  <section class="login-hero" aria-label="LabTrack">
    <div class="login-hero-inner">
      <div class="login-brand"><img class="lt-mark" src="/static/brand/labtrack-mark.svg" alt="" width="56" height="56"><span class="lt-word"><span class="lt-lab">Lab</span><span class="lt-track">Track</span></span></div>
      <p class="login-descriptor">Laboratory Information Management System</p>
      <p class="login-tagline">Precision in Every Result.</p>
    </div>
    <p class="login-hero-foot">SynergyOne LabTrack</p>
  </section>
  <section class="login-panel">
    <div class="login-col">
    <div class="card login-card"><div class="card-body">
    <h1 class="h4 mb-1">Sign in</h1>
    <p class="text-body-secondary small mb-4">to LabTrack</p>
    {{#if error}}<div class="alert alert-danger" role="alert">{{error}}</div>{{/if}}
    {{#if directory}}<p class="small text-body-secondary">Sign in with your {{directory.label}} username and password. Local accounts also sign in here.</p>{{else}}{{#if sso}}<p class="small text-body-secondary">Use your {{sso.label}} below. The username and password here are for local accounts only.</p>{{/if}}{{/if}}
    <form method="post" action="/login" autocomplete="off">
      <input type="hidden" name="_csrf" value="{{loginCsrf}}">
      <input type="hidden" name="next" value="{{next}}">
      <div class="mb-3">
        <label class="form-label" for="username">Username</label>
        <input class="form-control" id="username" name="username" required autofocus>
      </div>
      <div class="mb-3">
        <label class="form-label" for="password">Password</label>
        <input class="form-control" id="password" name="password" type="password" required>
      </div>
      <button class="btn btn-primary w-100" type="submit">Sign in</button>
    </form>
    {{#if sso}}
    <p class="text-center text-body-secondary small my-3">or</p>
    <a class="btn btn-outline-primary w-100" href="{{sso.href}}">Sign in with your {{sso.label}}</a>
    {{/if}}
    </div></div>
    <footer class="login-endorse">
      <span>Part of the SynergyOne Suite</span>
      <img src="/static/brand/synergy-informatics.jpg" alt="Synergy Informatics, informing medical decisions" width="200" height="59">
    </footer>
    </div>
  </section>
</div>
