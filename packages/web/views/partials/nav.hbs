<aside class="app-sidebar d-print-none" aria-label="Main menu">
  <div class="app-sidebar-head d-flex align-items-center justify-content-between px-3 py-2">
    <a class="app-brand text-decoration-none text-body fw-semibold d-flex align-items-center gap-2" href="/">{{icon "hospital"}}<span>Lab middleware</span></a>
    <label class="btn btn-outline-secondary btn-sm app-nav-button" for="app-nav-toggle">{{icon "list"}}<span>Menu</span></label>
  </div>
  <input type="checkbox" id="app-nav-toggle" class="app-nav-toggle visually-hidden" aria-label="Show the menu">
  <div class="app-nav">
    <nav>
      {{#each nav}}
      <details class="app-nav-group" data-group="{{key}}"{{#if current}} data-current{{/if}} open>
        <summary class="app-nav-heading">{{label}}{{icon "chevron-down"}}</summary>
        <ul class="nav flex-column">
          {{#each links}}<li class="nav-item"><a class="nav-link{{#if active}} active{{/if}}" href="{{href}}"{{#if active}} aria-current="page"{{/if}}>{{icon icon}}<span>{{label}}</span>{{#if count}}<span class="badge rounded-pill text-bg-{{countTone}} ms-auto">{{count}}<span class="visually-hidden"> waiting</span></span>{{/if}}</a></li>{{/each}}
        </ul>
      </details>
      {{/each}}
    </nav>
  </div>
</aside>
