{{!-- Password re-entry for local accounts; hospital sign-in accounts confirm at the IdP instead (10 §3). --}}
{{#if @root.stepUp}}<span class="d-block small mb-2">{{#if @root.stepUp.until}}Confirmed at the hospital sign-in for one action, until {{@root.stepUp.until}}.{{else}}<a href="{{@root.stepUp.href}}">Confirm with the hospital sign-in</a> first.{{/if}}</span>{{else}}{{#if label}}<label class="{{labelClass}}" for="{{id}}">{{label}}</label>{{/if}}<input class="{{inputClass}}"{{#if id}} id="{{id}}"{{/if}} name="{{#if name}}{{name}}{{else}}password{{/if}}" type="password" required{{#unless label}} placeholder="Your password" aria-label="Your password"{{/unless}}>{{/if}}
