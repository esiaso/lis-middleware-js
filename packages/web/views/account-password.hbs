<h1 class="h4">Change password</h1>
{{#if forced}}<div class="alert alert-warning" role="alert">An administrator set a temporary password for this account. Choose your own before you continue.</div>{{/if}}
{{> issues}}
<form method="post" action="/account/password" class="card card-body col-md-6">
  <input type="hidden" name="_csrf" value="{{csrf}}">
  <label class="form-label" for="currentPassword">Current password</label>
  <input class="form-control mb-2" id="currentPassword" name="currentPassword" type="password" required autocomplete="current-password">
  <label class="form-label" for="newPassword">New password (at least 12 characters)</label>
  <input class="form-control mb-2" id="newPassword" name="newPassword" type="password" minlength="12" required autocomplete="new-password">
  <label class="form-label" for="confirmPassword">New password again</label>
  <input class="form-control mb-3" id="confirmPassword" name="confirmPassword" type="password" minlength="12" required autocomplete="new-password">
  <button class="btn btn-primary" type="submit">Change password</button>
  <p class="note small text-body-secondary mt-2 mb-0">Your other sessions end; this one stays signed in.</p>
</form>
