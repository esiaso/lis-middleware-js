<div class="d-flex align-items-baseline gap-3"><h1 class="h4">Test catalogue</h1><a href="/worksheet">Manual worksheet</a></div>
<p class="text-body-secondary">The lab's own list of tests. The HMIS orders tests by LOINC code; approving a test with a LOINC code links HMIS orders for that code to it. Instrument test codes are linked on each instrument's mapping page. Tests performed by a person are entered on the manual worksheet. The middleware comes with no tests and no codes: every row here, and every LOINC code, was entered by the lab and approved by a second person. Results already made keep the version they were made with.</p>

{{#if drafts}}
<h2 class="h5 mt-4">Waiting for approval</h2>
<table class="table table-sm align-middle">
  <thead><tr><th>Code</th><th>Version</th><th>Test</th><th>LOINC</th><th>Result</th><th>Why</th><th>Proposed by</th>{{#if canEdit}}<th></th>{{/if}}</tr></thead>
  <tbody>
    {{#each drafts}}
    <tr>
      <td class="font-monospace">{{localCode}}</td><td>{{versionNo}}</td>
      <td>{{name}} <span class="small text-body-secondary">{{section}}{{#if manual}}, by hand{{/if}}</span></td>
      <td class="font-monospace">{{loinc}}</td>
      <td>{{type}}{{#if unit}} ({{unit}}){{/if}}{{#each components}}<span class="badge text-bg-light border ms-1 font-monospace">{{this}}</span>{{/each}}{{#each answers}}<span class="badge text-bg-light border ms-1">{{code}} {{display}}{{#if abnormal}} *{{/if}}</span>{{/each}}</td>
      <td class="small">{{reason}}</td><td class="small">{{by}}, {{at}}</td>
      {{#if @root.canEdit}}
      <td>
        {{#if mine}}<span class="small text-body-secondary">Another person approves this.</span>{{else}}
        <form method="post" action="/catalogue/{{id}}/approve" class="mb-1">
          <input type="hidden" name="_csrf" value="{{@root.csrf}}">
          {{> confirm inputClass="form-control form-control-sm mb-1"}}
          <button class="btn btn-primary btn-sm" type="submit">Approve</button>
        </form>{{/if}}
        <details><summary class="small">Discard</summary>
          <form method="post" action="/catalogue/{{id}}/discard" class="mt-2">
            <input type="hidden" name="_csrf" value="{{@root.csrf}}">
            <input class="form-control form-control-sm mb-1" name="reason" minlength="5" required placeholder="Reason" aria-label="Reason">
            <button class="btn btn-outline-danger btn-sm" type="submit">Discard draft</button>
          </form>
        </details>
      </td>
      {{/if}}
    </tr>
    {{/each}}
  </tbody>
</table>
{{/if}}

<h2 class="h5 mt-4">Tests in use</h2>
<table class="table table-sm align-middle">
  <thead><tr><th>Code</th><th>Test</th><th>Bench</th><th>LOINC</th><th>Result</th><th>Specimen</th><th>Approved</th>{{#if canEdit}}<th></th>{{/if}}</tr></thead>
  <tbody>
    {{#each tests}}
    <tr>
      <td class="font-monospace">{{localCode}} <span class="small text-body-secondary">v{{versionNo}}</span></td>
      <td>{{name}}{{#if manual}} <span class="badge text-bg-secondary">by hand</span>{{/if}}</td>
      <td>{{section}}</td>
      <td>{{#if loinc}}<span class="font-monospace">{{loinc}}</span>{{#if loincDisplay}}<div class="small text-body-secondary">{{loincDisplay}}</div>{{/if}}{{else}}<span class="text-body-secondary">none</span>{{/if}}{{#if sha}}<div class="small">SHA {{sha}}</div>{{/if}}</td>
      <td>{{type}}{{#if unit}} ({{unit}}){{/if}}{{#each components}}<span class="badge text-bg-light border ms-1 font-monospace">{{this}}</span>{{/each}}{{#each answers}}<span class="badge text-bg-light border ms-1">{{code}} {{display}}{{#if abnormal}} *{{/if}}</span>{{/each}}</td>
      <td>{{specimenType}}</td>
      <td class="small">{{approvedBy}}, {{approvedAt}}</td>
      {{#if @root.canEdit}}
      <td>
        <a class="small" href="/catalogue?edit={{localCode}}#change">Change</a>
        <details><summary class="small">Retire</summary>
          <form method="post" action="/catalogue/retire" class="mt-2">
            <input type="hidden" name="_csrf" value="{{@root.csrf}}">
            <input type="hidden" name="localCode" value="{{localCode}}">
            <input class="form-control form-control-sm mb-1" name="reason" minlength="5" required placeholder="Reason" aria-label="Reason">
            {{> confirm inputClass="form-control form-control-sm mb-1"}}
            <button class="btn btn-outline-danger btn-sm" type="submit">Retire test</button>
          </form>
        </details>
      </td>
      {{/if}}
    </tr>
    {{else}}
    <tr><td colspan="8" class="text-body-secondary">No tests in the catalogue yet.</td></tr>
    {{/each}}
  </tbody>
</table>
<p class="small text-body-secondary">* marks an answer the lab counts as abnormal; it is flagged on the result.</p>

{{#if canEdit}}
<h2 class="h5 mt-4" id="change">{{#if editing}}Change {{v.localCode}}{{else}}Add a test{{/if}}</h2>
<p class="small text-body-secondary">Saving makes a draft. Another person approves it on this page before it is used. Pick each LOINC code from the LOINC release the HMIS uses, for this method and specimen: a malaria smear and a malaria rapid test have different codes.</p>
{{> issues}}
<form method="post" action="/catalogue" class="row g-3">
  <input type="hidden" name="_csrf" value="{{csrf}}">
  <div class="col-md-2"><label class="form-label" for="localCode">Local code</label><input class="form-control font-monospace text-uppercase" id="localCode" name="localCode" value="{{v.localCode}}" required maxlength="20"><div class="form-text">Such as MAL-RDT.</div></div>
  <div class="col-md-5"><label class="form-label" for="name">Name</label><input class="form-control" id="name" name="name" value="{{v.name}}" required maxlength="120"></div>
  <div class="col-md-3"><label class="form-label" for="section">Bench</label><input class="form-control" id="section" name="section" value="{{v.section}}" required maxlength="40"><div class="form-text">Such as Parasitology.</div></div>
  <div class="col-md-2"><label class="form-label" for="specimenType">Specimen</label><input class="form-control" id="specimenType" name="specimenType" value="{{v.specimenType}}" maxlength="40"></div>
  <div class="col-md-2"><label class="form-label" for="loincCode">LOINC code</label><input class="form-control font-monospace" id="loincCode" name="loincCode" value="{{v.loincCode}}" maxlength="10"><div class="form-text">The check digit is checked.</div></div>
  <div class="col-md-6"><label class="form-label" for="loincDisplay">LOINC name</label><input class="form-control" id="loincDisplay" name="loincDisplay" value="{{v.loincDisplay}}" maxlength="255"></div>
  <div class="col-md-2"><label class="form-label" for="shaCode">SHA code</label><input class="form-control" id="shaCode" name="shaCode" value="{{v.shaCode}}" maxlength="40"><div class="form-text">Only from SHA's own list.</div></div>
  <div class="col-md-2"><label class="form-label" for="performedBy">Performed by</label><select class="form-select" id="performedBy" name="performedBy">{{#each performed}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
  <div class="col-md-3"><label class="form-label" for="resultType">Result type</label><select class="form-select" id="resultType" name="resultType">{{#each types}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select><div class="form-text">Ordered choice keeps the answers in order (Negative, Trace, 1+, ...). A panel is ordered as one code and resulted as its component tests.</div></div>
  <div class="col-md-2"><label class="form-label" for="unit">Unit (UCUM)</label><input class="form-control" id="unit" name="unit" value="{{v.unit}}" maxlength="40"></div>
  <div class="col-md-2"><label class="form-label" for="decimals">Decimals</label><input class="form-control" id="decimals" name="decimals" value="{{v.decimals}}" inputmode="numeric" maxlength="1"></div>
  <div class="col-md-3"><label class="form-label" for="components">Component tests (panels)</label><textarea class="form-control font-monospace text-uppercase" id="components" name="components" rows="5">{{v.components}}</textarea><div class="form-text">Local codes, one per line, in report order. Each must already be in the catalogue.</div></div>
  <div class="col-md-5"><label class="form-label" for="answers">Answers (choice results)</label><textarea class="form-control font-monospace" id="answers" name="answers" rows="5">{{v.answers}}</textarea><div class="form-text">One per line: <code>code | words</code>, then <code>| abnormal</code> if it is outside normal, and <code>| LA code</code> if the lab has chosen a LOINC answer code.</div></div>
  <div class="col-md-7"><label class="form-label" for="reason">Why</label><input class="form-control" id="reason" name="reason" value="{{reason}}" required minlength="5" maxlength="500"></div>
  <div class="col-12"><button class="btn btn-primary" type="submit">Save draft</button></div>
</form>
{{/if}}
