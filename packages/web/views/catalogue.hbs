<div class="page-head">
  <h1 class="h4 mb-0">Test catalogue</h1>
  <div class="ms-auto d-flex gap-2 d-print-none">
    <a class="btn btn-outline-secondary btn-sm" href="/worksheet">Manual worksheet</a>
    {{#if canEdit}}<a class="btn btn-primary btn-sm" href="/catalogue/new">{{icon "plus-lg"}} Add a test</a>{{/if}}
  </div>
</div>
<p class="note text-body-secondary">The lab's own list of tests. The HMIS orders tests by LOINC code; approving a test with a LOINC code links HMIS orders for that code to it. Instrument test codes are linked on each instrument's mapping page. Tests performed by a person are entered on the manual worksheet. The middleware comes with no tests and no codes: every row here, and every LOINC code, was entered by the lab and approved by a second person. Results already made keep the version they were made with.</p>

{{#if drafts}}
<h2 class="section-title mt-3">Waiting for approval <span class="badge text-bg-warning">{{drafts.length}}</span></h2>
<table class="table table-sm align-middle">
  <thead><tr><th>Code</th><th>Version</th><th>Test</th><th>LOINC</th><th>Result</th><th>Why</th><th>Proposed by</th>{{#if canEdit}}<th></th>{{/if}}</tr></thead>
  <tbody>
    {{#each drafts}}
    <tr>
      <td class="font-monospace">{{localCode}}</td><td>{{versionNo}}</td>
      <td>{{name}} <span class="small text-body-secondary">{{section}}{{#if manual}}, by hand{{/if}}</span></td>
      <td class="font-monospace">{{loinc}}</td>
      <td>{{type}}{{#if unit}} ({{unit}}){{/if}}{{#each components}}<span class="badge text-bg-light border ms-1 font-monospace">{{this}}</span>{{/each}}{{#each answers}}<span class="badge text-bg-light border ms-1">{{code}} {{display}}{{#if critical}} <strong>!</strong>{{else if abnormal}} *{{/if}}</span>{{/each}}</td>
      <td class="small">{{reason}}</td><td class="small">{{by}}, {{at}}</td>
      {{#if @root.canEdit}}
      <td>
        {{#if mine}}<span class="small text-body-secondary">Another person approves this.</span>{{else}}
        <form method="post" action="/catalogue/{{id}}/approve" class="mb-1">
          <input type="hidden" name="_csrf" value="{{@root.csrf}}">
          {{> confirm inputClass="form-control form-control-sm mb-1"}}
          <button class="btn btn-primary btn-sm" type="submit">Approve</button>
        </form>{{/if}}
        <details><summary class="small">Discard</summary>
          <form method="post" action="/catalogue/{{id}}/discard" class="mt-2">
            <input type="hidden" name="_csrf" value="{{@root.csrf}}">
            <input class="form-control form-control-sm mb-1" name="reason" minlength="5" required placeholder="Reason" aria-label="Reason">
            <button class="btn btn-outline-danger btn-sm" type="submit">Discard draft</button>
          </form>
        </details>
      </td>
      {{/if}}
    </tr>
    {{/each}}
  </tbody>
</table>
{{/if}}

<h2 class="section-title mt-4">Tests in use <span class="badge text-bg-secondary">{{tests.length}}{{#if filtered}} of {{total}}{{/if}}</span></h2>
<form method="get" action="/catalogue" class="catalogue-filter d-print-none" role="search">
  <div><label class="form-label small" for="q">Find</label><input class="form-control form-control-sm" id="q" name="q" value="{{q}}" placeholder="Code, name, LOINC or SHA"></div>
  <div><label class="form-label small" for="bench">Bench</label><select class="form-select form-select-sm" id="bench" name="bench"><option value="">All benches</option>{{#each benches}}<option {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></div>
  <div><label class="form-label small" for="by">Performed by</label><select class="form-select form-select-sm" id="by" name="by"><option value="">Anyone</option>{{#each by}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
  <button class="btn btn-outline-primary btn-sm" type="submit">Filter</button>
  {{#if filtered}}<a class="btn btn-link btn-sm" href="/catalogue">Clear</a>{{/if}}
</form>
<table class="table table-sm align-middle">
  <thead><tr><th>Code</th><th>Test</th><th>Bench</th><th>LOINC</th><th>Result</th><th>Specimen</th><th>Approved</th>{{#if canEdit}}<th></th>{{/if}}</tr></thead>
  <tbody>
    {{#each tests}}
    <tr>
      <td class="font-monospace">{{localCode}} <span class="small text-body-secondary">v{{versionNo}}</span></td>
      <td>{{name}}{{#if manual}} <span class="badge text-bg-secondary">by hand</span>{{/if}}</td>
      <td>{{section}}</td>
      <td>{{#if loinc}}<span class="font-monospace">{{loinc}}</span>{{#if loincDisplay}}<div class="small text-body-secondary">{{loincDisplay}}</div>{{/if}}{{else}}<span class="text-body-secondary">none</span>{{/if}}{{#if sha}}<div class="small">SHA {{sha}}</div>{{/if}}</td>
      <td>{{type}}{{#if unit}} ({{unit}}){{/if}}{{#each components}}<span class="badge text-bg-light border ms-1 font-monospace">{{this}}</span>{{/each}}{{#each answers}}<span class="badge text-bg-light border ms-1">{{code}} {{display}}{{#if critical}} <strong>!</strong>{{else if abnormal}} *{{/if}}</span>{{/each}}{{#if qc}}<div class="small">QC: {{qc}}</div>{{/if}}</td>
      <td>{{specimenType}}</td>
      <td class="small">{{approvedBy}}, {{approvedAt}}</td>
      {{#if @root.canEdit}}
      <td>
        <a class="btn btn-outline-primary btn-sm mb-1" href="/catalogue/{{localCode}}/edit">Change</a>
        <details><summary class="small">Retire</summary>
          <form method="post" action="/catalogue/retire" class="mt-2">
            <input type="hidden" name="_csrf" value="{{@root.csrf}}">
            <input type="hidden" name="localCode" value="{{localCode}}">
            <input class="form-control form-control-sm mb-1" name="reason" minlength="5" required placeholder="Reason" aria-label="Reason">
            {{> confirm inputClass="form-control form-control-sm mb-1"}}
            <button class="btn btn-outline-danger btn-sm" type="submit">Retire test</button>
          </form>
        </details>
      </td>
      {{/if}}
    </tr>
    {{else}}
    <tr><td colspan="8" class="text-body-secondary">{{#if filtered}}No tests match. <a href="/catalogue">Show all</a>{{else}}No tests in the catalogue yet.{{/if}}</td></tr>
    {{/each}}
  </tbody>
</table>
<p class="note small text-body-secondary">* marks an answer the lab counts as abnormal; it is flagged on the result. <strong>!</strong> marks a critical answer: it must be phoned to the clinician, read back and recorded before the result can be approved.</p>
