<h1 class="h4 mb-3">Unmatched results</h1>
<p class="text-body-secondary">Instrument results that could not be attached to an order. They are never guessed onto a patient.</p>
<table class="table table-sm align-middle">
  <thead><tr><th>Received</th><th>Instrument</th><th>Sample ID</th><th>Test</th><th>Value</th><th>Reason</th><th></th>{{#if can.dismiss}}<th>Close</th>{{/if}}</tr></thead>
  <tbody>
    {{#each rows}}
    <tr>
      <td class="small">{{at}}</td><td>{{instrumentId}}</td><td class="font-monospace">{{sampleId}}</td><td>{{test}}</td><td class="font-monospace">{{value}} {{units}}</td><td>{{reason}}{{#if proposed}} <span class="badge text-bg-warning">link proposed</span>{{/if}}</td><td><a href="/unmatched/{{id}}">Resolve</a></td>
      {{#if ../can.dismiss}}
      <td>
        <form method="post" action="/unmatched/{{id}}/dismiss" class="d-flex gap-1">
          <input type="hidden" name="_csrf" value="{{../csrf}}">
          <input class="form-control form-control-sm" name="reason" placeholder="Reason" minlength="5" required aria-label="Reason">
          <button class="btn btn-sm btn-outline-secondary" type="submit">Close</button>
        </form>
      </td>
      {{/if}}
    </tr>
    {{else}}
    <tr><td colspan="8" class="text-body-secondary">Nothing unmatched.</td></tr>
    {{/each}}
  </tbody>
</table>
