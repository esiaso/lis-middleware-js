<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {{#if refresh}}<meta http-equiv="refresh" content="{{refresh}}">{{/if}}
  <title>{{title}} · Lab middleware</title>
  <link rel="stylesheet" href="/static/bootstrap/bootstrap.min.css">
  <link rel="stylesheet" href="/static/app.css">
  {{#if user}}<script src="/static/early.js"></script><script src="/static/app.js" defer></script>{{/if}}
</head>
<body>
  {{#if user}}
  <div class="app-shell">
    {{> nav}}
    <main class="app-main py-3 px-3 px-lg-4">
      {{#if crumbs.length}}<nav class="app-crumbs d-print-none" aria-label="Breadcrumb"><ol class="breadcrumb">{{#each crumbs}}<li class="breadcrumb-item"><a href="{{href}}">{{label}}</a></li>{{/each}}<li class="breadcrumb-item active" aria-current="page">{{title}}</li></ol></nav>{{/if}}
      {{#if notice}}<div class="alert alert-success" role="status">{{notice}}</div>{{/if}}
      {{{body}}}
    </main>
  </div>
  {{else}}
  <main class="container-fluid py-3">
    {{#if notice}}<div class="alert alert-success" role="status">{{notice}}</div>{{/if}}
    {{{body}}}
  </main>
  {{/if}}
</body>
</html>
