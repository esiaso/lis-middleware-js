<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {{#if refresh}}<meta http-equiv="refresh" content="{{refresh}}">{{/if}}
  <title>{{title}} · Lab middleware</title>
  <link rel="stylesheet" href="/static/bootstrap/bootstrap.min.css">
  <link rel="stylesheet" href="/static/app.css">
  <link rel="stylesheet" href="/static/theme.css">
  {{#if user}}<script src="/static/early.js"></script><script src="/static/app.js" defer></script>{{/if}}
</head>
<body>
  {{#if user}}
  <div class="app-shell">
    {{> nav}}
    <div class="app-body">
      <header class="app-topbar d-print-none">
        {{#if crumbs.length}}<nav class="app-crumbs" aria-label="Breadcrumb"><ol class="breadcrumb">{{#each crumbs}}<li class="breadcrumb-item"><a href="{{href}}">{{label}}</a></li>{{/each}}<li class="breadcrumb-item active" aria-current="page">{{title}}</li></ol></nav>{{else}}<span class="app-topbar-title">{{title}}</span>{{/if}}
        <div class="app-user">
          <span class="app-avatar" aria-hidden="true">{{initials}}</span>
          <span class="app-user-text">{{#if user.external}}<span class="app-user-name">{{user.displayName}}</span>{{else}}<a class="app-user-name" href="/account/password" title="Change password">{{user.displayName}}</a>{{/if}}<span class="app-user-roles">{{#each user.roles}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</span></span>
          <form method="post" action="/logout" class="app-signout">
            <input type="hidden" name="_csrf" value="{{csrf}}">
            <button class="btn btn-light btn-sm" type="submit" title="Sign out">{{icon "box-arrow-right"}}<span class="app-signout-label">Sign out</span></button>
          </form>
        </div>
      </header>
      <main class="app-main">
        {{#if notice}}<div class="alert alert-success" role="status">{{notice}}</div>{{/if}}
        {{{body}}}
      </main>
    </div>
  </div>
  {{else}}
  <main class="container-fluid py-3">
    {{#if notice}}<div class="alert alert-success" role="status">{{notice}}</div>{{/if}}
    {{{body}}}
  </main>
  {{/if}}
</body>
</html>
