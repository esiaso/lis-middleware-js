      "@lis/analyzer-runtime": ["./packages/analyzer-runtime/src/index.ts"],
      "@lis/db": ["./packages/db/src/index.ts"],
      "@lis/analyzer-worker": ["./packages/analyzer-worker/src/index.ts"],
