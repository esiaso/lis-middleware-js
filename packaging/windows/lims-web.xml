<!-- WinSW v2 service definition (11 §3). install.ps1 sets the account to the virtual account NT SERVICE\lims-web. -->
<service>
  <id>lims-web</id>
  <name>lims-web</name>
  <description>LIMS web screens</description>
  <executable>%BASE%\..\runtime\node\node.exe</executable>
  <arguments>node_modules\@lis\web\dist\main.js</arguments>
  <workingdirectory>%BASE%\..\app</workingdirectory>
  <env name="NODE_ENV" value="production" />
  <env name="DATABASE_URL_FILE" value="C:\ProgramData\LIMS Middleware\secrets\database_url" />
  <env name="BIND_HOST" value="127.0.0.1" />
  <env name="PORT" value="3000" />
  <env name="LIMS_TWO_PERSON_RULE" value="true" />
  <startmode>Automatic</startmode>
  <delayedAutoStart>true</delayedAutoStart>
  <onfailure action="restart" delay="5 sec" />
  <onfailure action="restart" delay="10 sec" />
  <onfailure action="restart" delay="30 sec" />
  <resetfailure>1 hour</resetfailure>
  <stoptimeout>30 sec</stoptimeout>
  <logpath>C:\ProgramData\LIMS Middleware\logs</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>20</keepFiles>
  </log>
</service>
