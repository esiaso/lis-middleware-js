<!-- WinSW v2 service definition (11 §3). install.ps1 sets the account to the virtual account NT SERVICE\lims-web. -->
<service>
  <id>lims-web</id>
  <name>lims-web</name>
  <description>LIMS web screens</description>
  <executable>%BASE%\..\runtime\node\node.exe</executable>
  <arguments>node_modules\@lis\web\dist\main.js</arguments>
  <workingdirectory>%BASE%\..\app</workingdirectory>
  <env name="NODE_ENV" value="production" />
  <env name="DATABASE_URL_FILE" value="C:\ProgramData\LIMS Middleware\secrets\database_url" />
  <env name="BIND_HOST" value="127.0.0.1" />
  <env name="PORT" value="3000" />
  <env name="LIMS_TWO_PERSON_RULE" value="true" />
  <!-- Hospital sign-in (11 §11): uncomment and fill in. The secret file is readable by NT SERVICE\lims-web only.
  <env name="LIMS_OIDC_ISSUER" value="https://idp.example/realms/hospital" />
  <env name="LIMS_OIDC_CLIENT_ID" value="lims" />
  <env name="LIMS_OIDC_CLIENT_SECRET_FILE" value="C:\ProgramData\LIMS Middleware\secrets\oidc_client_secret" />
  <env name="LIMS_OIDC_REDIRECT_URI" value="https://lims.example/login/oidc/callback" />
  <env name="LIMS_OIDC_ROLE_MAP" value="LIMS-Admins=admin;LIMS-Approvers=approver" />
  -->
  <!-- Signed audit exports (11 §11): run lims audit keygen, then uncomment.
  <env name="LIMS_AUDIT_SIGNING_KEY_FILE" value="C:\ProgramData\LIMS Middleware\secrets\audit_signing_key" />
  -->
  <!-- Directory sign-in over LDAPS (11 §11): uncomment and fill in. The password file is readable by NT SERVICE\lims-web only.
  <env name="LIMS_LDAP_URL" value="ldaps://dc1.hospital.example:636" />
  <env name="LIMS_LDAP_BIND_DN" value="CN=svc-lims,OU=Service Accounts,DC=hospital,DC=example" />
  <env name="LIMS_LDAP_BIND_PASSWORD_FILE" value="C:\ProgramData\LIMS Middleware\secrets\ldap_bind_password" />
  <env name="LIMS_LDAP_BASE_DN" value="OU=Staff,DC=hospital,DC=example" />
  <env name="LIMS_LDAP_USER_FILTER" value="(&amp;(objectClass=user)(sAMAccountName={username}))" />
  <env name="LIMS_LDAP_ID_ATTRIBUTE" value="objectGUID" />
  <env name="LIMS_LDAP_ROLE_MAP" value="CN=LIMS Admins,OU=Groups,DC=hospital,DC=example=admin;CN=LIMS Approvers,OU=Groups,DC=hospital,DC=example=approver" />
  -->
  <startmode>Automatic</startmode>
  <delayedAutoStart>true</delayedAutoStart>
  <onfailure action="restart" delay="5 sec" />
  <onfailure action="restart" delay="10 sec" />
  <onfailure action="restart" delay="30 sec" />
  <resetfailure>1 hour</resetfailure>
  <stoptimeout>30 sec</stoptimeout>
  <logpath>C:\ProgramData\LIMS Middleware\logs</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>20</keepFiles>
  </log>
</service>
