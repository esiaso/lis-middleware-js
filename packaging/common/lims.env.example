# LIMS middleware settings. Linux: /etc/lims/lims.env. Windows: set in each service's XML.
# The database URL is NOT set here: it lives in a credential file
# (Linux /etc/lims/secrets/database_url, Windows C:\ProgramData\LIMS Middleware\secrets\database_url).
NODE_ENV=production

# Web: listen on loopback; the reverse proxy terminates TLS (11 §4).
BIND_HOST=127.0.0.1
PORT=3000
# Reviewer and approver must be different people (10 §2).
LIMS_TWO_PERSON_RULE=true
# Only for a loopback-only test setup without TLS. Never true in production.
LIMS_INSECURE_COOKIES=false
# The lab's time zone for showing and typing times, and for report days (01 A-24). Unset = UTC.
#LIMS_TIME_ZONE=Africa/Nairobi

# Hospital sign-in through OIDC (11 §11). Unset = local accounts only.
# The client secret, if any, is a credential file, not set here.
#LIMS_OIDC_ISSUER=https://idp.example/realms/hospital
#LIMS_OIDC_CLIENT_ID=lims
#LIMS_OIDC_REDIRECT_URI=https://lims.example/login/oidc/callback
#LIMS_OIDC_ROLE_MAP=LIMS-Admins=admin;LIMS-Approvers=approver;LIMS-Technologists=technologist;LIMS-Operators=operator;LIMS-Auditors=auditor
#LIMS_OIDC_GROUPS_CLAIM=groups
#LIMS_OIDC_PROMPT_LOGIN=true
# If the IdP certificate comes from the hospital CA:
#NODE_EXTRA_CA_CERTS=/etc/lims/hospital-ca.pem
