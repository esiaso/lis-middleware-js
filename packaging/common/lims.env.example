# LIMS middleware settings. Linux: /etc/lims/lims.env. Windows: set in each service's XML.
# The database URL is NOT set here: it lives in a credential file
# (Linux /etc/lims/secrets/database_url, Windows C:\ProgramData\LIMS Middleware\secrets\database_url).
NODE_ENV=production

# Web: listen on loopback; the reverse proxy terminates TLS (11 §4).
BIND_HOST=127.0.0.1
PORT=3000
# Reviewer and approver must be different people (10 §2).
LIMS_TWO_PERSON_RULE=true
# Only for a loopback-only test setup without TLS. Never true in production.
LIMS_INSECURE_COOKIES=false
# The lab's time zone for showing and typing times, and for report days (01 A-24). Unset = UTC.
#LIMS_TIME_ZONE=Africa/Nairobi

# Hospital sign-in through OIDC (11 §11). Unset = local accounts only.
# The client secret, if any, is a credential file, not set here.
#LIMS_OIDC_ISSUER=https://idp.example/realms/hospital
#LIMS_OIDC_CLIENT_ID=lims
#LIMS_OIDC_REDIRECT_URI=https://lims.example/login/oidc/callback
#LIMS_OIDC_ROLE_MAP=LIMS-Admins=admin;LIMS-Approvers=approver;LIMS-Technologists=technologist;LIMS-Operators=operator;LIMS-Auditors=auditor
#LIMS_OIDC_GROUPS_CLAIM=groups
#LIMS_OIDC_PROMPT_LOGIN=true
# Hospital sign-in through the directory over LDAPS (11 §11). Unset = none.
# The service account password is a credential file (lims secrets set ldap_bind_password), not set here.
#LIMS_LDAP_URL=ldaps://dc1.hospital.example:636
#LIMS_LDAP_BIND_DN=CN=svc-lims,OU=Service Accounts,DC=hospital,DC=example
#LIMS_LDAP_BASE_DN=OU=Staff,DC=hospital,DC=example
#LIMS_LDAP_USER_FILTER=(&(objectClass=user)(sAMAccountName={username}))
#LIMS_LDAP_ID_ATTRIBUTE=objectGUID
#LIMS_LDAP_ROLE_MAP=CN=LIMS Admins,OU=Groups,DC=hospital,DC=example=admin;CN=LIMS Approvers,OU=Groups,DC=hospital,DC=example=approver
#LIMS_LDAP_CA_FILE=/etc/lims/hospital-ca.pem
# The HMIS link (FHIR R4, 11 §11), read by lims-jobs. Unset = none.
# The client secret is a credential file (lims secrets set hmis_client_secret), not set here.
#LIMS_HMIS_PROFILE=fhir-r4
#LIMS_HMIS_BASE_URL=https://hmis.hospital.example/fhir
#LIMS_HMIS_TOKEN_URL=https://hmis.hospital.example/oauth/token
#LIMS_HMIS_CLIENT_ID=lims-middleware
#LIMS_HMIS_MRN_SYSTEM=https://hmis.hospital.example/id/mrn
#LIMS_HMIS_ORDER_SYSTEM=https://hmis.hospital.example/id/order
#LIMS_HMIS_ORDER_LINE_SYSTEM=https://hmis.hospital.example/id/order-line
#LIMS_HMIS_TEST_SYSTEM=https://hmis.hospital.example/code/test
#LIMS_HMIS_PAGE_SIZE=100
#LIMS_HMIS_POLL_SECONDS=30
# If the IdP certificate comes from the hospital CA:
#NODE_EXTRA_CA_CERTS=/etc/lims/hospital-ca.pem
