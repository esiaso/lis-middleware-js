#!/bin/sh
# Operations CLI from the release bundle: lims verify | status | db migrate | config validate | secrets set <name> | diag tcp|bundle | backup create|verify | version
set -eu
HERE=$(dirname "$(readlink -f "$0")")/..
if [ -z "${DATABASE_URL:-}${DATABASE_URL_FILE:-}${CREDENTIALS_DIRECTORY:-}" ] && [ -r /etc/lims/secrets/database_url ]; then
  DATABASE_URL_FILE=/etc/lims/secrets/database_url
  export DATABASE_URL_FILE
fi
LIMS_HOME="$HERE"
export LIMS_HOME
exec "$HERE/runtime/node/bin/node" "$HERE/app/node_modules/@lis/ops/dist/main.js" "$@"
